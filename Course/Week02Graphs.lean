namespace Course

open Set

/-! ## The graph space (`def:graph-space`, `ex:graphs`) -/

/-- A finite graph: a finite set `V` of vertices, a finite set `E` of edges, and
`∂ : E × {0,1} → V` naming the two ends of each edge. Loops and multiple edges are allowed.
`def:graph-space`. Mathlib: none (Mathlib's `SimpleGraph`, `Quiver` carry no topology).

Lean: `structure … where` lists the data, field by field. `Bool` is the two-point set
`{false, true}`, which plays `{0, 1}` (`false` for `0`, `true` for `1`). `[finV : Finite V]`
records that `V` is finite. For a graph `G`, its fields are `G.V`, `G.E`, `G.ends`. -/
structure Graph where
  /-- The vertices. -/
  V : Type
  /-- The edges. -/
  E : Type
  [finV : Finite V]
  [finE : Finite E]
  /-- `∂ : E × {0,1} → V`, the ends of each edge. -/
  ends : E × Bool → V

namespace Graph

variable (G : Graph)

/-- `V` carries the discrete topology. `def:graph-space`. -/
instance topV : TopSpace G.V := discrete G.V

/-- `E` carries the discrete topology, so that `E × [0,1]` is one copy of `[0, 1]` for each edge.
`def:graph-space`. -/
instance topE : TopSpace G.E := discrete G.E

/-- The ends `E × {0,1}` carry the discrete topology. `def:graph-space`; their topology plays no
part in the pushout. -/
instance topEnds : TopSpace (G.E × Bool) := discrete _

/-- The end `0` or `1` of `[0, 1]`: `false ↦ 0`, `true ↦ 1`. (Lean: `bif b then x else y` is `x`
if `b` is `true` and `y` if it is `false`.) -/
def endpt (b : Bool) : I := bif b then I.one else I.zero

/-- The inclusion `E × {0,1} ↪ E × [0,1]`, `(e, i) ↦ (e, i)`. `def:graph-space`. -/
def incl (p : G.E × Bool) : G.E × I := (p.1, endpt p.2)

/-- The graph space `Γ`, the pushout of `V ← E × {0,1} ↪ E × [0,1]`: one copy of `[0, 1]` for
each edge, its two ends glued to the vertices named by `∂`. `def:graph-space`. It is
`(V ⊔ (E × [0,1]))/∼` with the quotient topology (`thm:pushout-top`), `∼` generated by
`∂(e, i) ∼ (e, i)` for `i = 0, 1`.
Mathlib: none (a `TopCat` pushout; `SimpleGraph` has no geometric realisation in Mathlib). -/
abbrev Space : Type := Pushout G.ends G.incl

/-- The vertex `v` as a point of `Γ`: the class `[ι₁ v]`. -/
def vertex (v : G.V) : G.Space := Pushout.inl v

/-- The point `t` of the edge `e` as a point of `Γ`: the class `[ι₂ (e, t)]`. -/
def pt (e : G.E) (t : I) : G.Space := Pushout.inr (e, t)

/-- The end `0` of the edge `e` is the vertex `∂(e, 0)`: this is the gluing, `i ∘ ∂ = j ∘ incl`
(`pushout_comm`) at `(e, 0)`. -/
theorem pt_zero (e : G.E) : G.pt e I.zero = G.vertex (G.ends (e, false)) :=
  (congrFun pushout_comm (e, false)).symm

/-- The end `1` of the edge `e` is the vertex `∂(e, 1)`, in the same way. -/
theorem pt_one (e : G.E) : G.pt e I.one = G.vertex (G.ends (e, true)) :=
  (congrFun pushout_comm (e, true)).symm

/-- Every point of `Γ` is a vertex or a point of an edge: the quotient map is onto. -/
theorem cases (x : G.Space) : (∃ v, x = G.vertex v) ∨ ∃ e t, x = G.pt e t := by
  -- Write `x = [s]` for `s ∈ V ⊔ (E × [0,1])` (`Quotient.ind`); then `s` is `ι₁ v` for a vertex
  -- `v`, or `ι₂ (e, t)` for a point `(e, t)` (`rcases s with v | ⟨e, t⟩`).
  induction x using Quotient.ind with
  | _ s =>
    rcases s with v | ⟨e, t⟩
    · exact Or.inl ⟨v, rfl⟩
    · exact Or.inr ⟨e, t, rfl⟩

/-- Each edge maps continuously into `Γ`: `t ↦ G.pt e t` is the composite of `t ↦ (e, t)`,
continuous into `E × [0,1]` because its coordinates are (constant, identity; `thm:product-top`),
and of `j : E × [0,1] → Γ` (`continuous_pushout_inr`). -/
theorem continuous_pt (e : G.E) : Continuous (G.pt e) :=
  continuous_pushout_inr.comp (continuous_prodMk.mpr ⟨continuous_const, continuous_id⟩)

/-- The discrete topology on the values of `label`, only so that `Pushout.desc` applies; no
continuity of `label` is used.

Lean: `Option T` is `T` with one extra element `none`; the element `a ∈ T` is written `some a`.
`attribute [local instance] topLabel` makes this the topology used in this file. -/
def topLabel : TopSpace (Option (G.E × ℝ)) := discrete _

attribute [local instance] topLabel

/-- The interior coordinate `Γ → E × ℝ ∪ {none}`: `(e, t)` at an interior point `0 < t < 1` of the
edge `e`, and `none` at a vertex. It is well defined on `Γ` by the universal property of the
pushout (`thm:pushout-top`, `Pushout.desc`): on `E × [0,1]` it sends the ends `t = 0, 1` to
`none`, as it does the vertices, so it agrees on glued points (`simp` checks the two ends).
Mathlib: none. -/
noncomputable def label : G.Space → Option (G.E × ℝ) :=
  Pushout.desc (fun _ => none)
    (fun y => if 0 < (y.2 : ℝ) ∧ (y.2 : ℝ) < 1 then some (y.1, (y.2 : ℝ)) else none)
    (fun p => by
      rcases p with ⟨e, b⟩
      cases b <;> simp [incl, endpt, I.zero, I.one])

/-- Unfolding: the label of a vertex is `none`. -/
theorem label_vertex (v : G.V) : G.label (G.vertex v) = none := rfl

/-- Unfolding: the label of an interior point `0 < t < 1` of the edge `e` is `(e, t)`. -/
theorem label_pt {e : G.E} {t : I} (h0 : 0 < (t : ℝ)) (h1 : (t : ℝ) < 1) :
    G.label (G.pt e t) = some (e, (t : ℝ)) := by
  change (if 0 < (t : ℝ) ∧ (t : ℝ) < 1 then some (e, (t : ℝ)) else none) = _
  simp [h0, h1]

/-- Unfolding: the label of a point `t` of an edge that is not interior (`t = 0` or `1`) is
`none`. -/
theorem label_pt_of_not {e : G.E} {t : I} (h : ¬ (0 < (t : ℝ) ∧ (t : ℝ) < 1)) :
    G.label (G.pt e t) = none := by
  change (if 0 < (t : ℝ) ∧ (t : ℝ) < 1 then some (e, (t : ℝ)) else none) = _
  simp only [h, ite_false]

/-- An interior point `0 < t < 1` of an edge is not a vertex. -/
theorem pt_ne_vertex {e : G.E} {t : I} (h0 : 0 < (t : ℝ)) (h1 : (t : ℝ) < 1) (v : G.V) :
    G.pt e t ≠ G.vertex v := fun h => by
  -- If they were equal, so would be their labels, `(e, t)` and `none`; but `some a ≠ none`
  -- (Lean: `nomatch` dismisses an equation between different kinds of elements).
  have := congrArg G.label h
  rw [G.label_pt h0 h1, G.label_vertex] at this
  exact nomatch this

/-- An interior point `t₀` of an edge `e` is not the point `s` of any edge `e'`, for `s ≠ t₀`. -/
theorem pt_ne_pt {e e' : G.E} {t₀ s : I} (h0 : 0 < (t₀ : ℝ)) (h1 : (t₀ : ℝ) < 1)
    (hs : (s : ℝ) ≠ t₀) : G.pt e' s ≠ G.pt e t₀ := fun h => by
  -- Compare labels: the right side has label `(e, t₀)`. If `s` is interior the left side has
  -- label `(e', s)`, and `s ≠ t₀`; otherwise it has label `none`.
  have := congrArg G.label h
  rw [G.label_pt h0 h1] at this
  by_cases hs' : 0 < (s : ℝ) ∧ (s : ℝ) < 1
  · rw [G.label_pt hs'.1 hs'.2] at this
    exact hs (congrArg Prod.snd (Option.some.inj this))
  · rw [G.label_pt_of_not hs'] at this
    exact nomatch this

/-- A point `t` of `[0, 1]` other than `0` and `1` is interior. -/
theorem interior_of_ne {t : I} (h0 : (t : ℝ) ≠ 0) (h1 : (t : ℝ) ≠ 1) :
    0 < (t : ℝ) ∧ (t : ℝ) < 1 :=
  ⟨lt_of_le_of_ne t.2.1 (Ne.symm h0), lt_of_le_of_ne t.2.2 h1⟩

/-- A point `t` of an edge `e` that is not interior is a vertex. -/
theorem pt_eq_vertex_of_not {e : G.E} {t : I} (h : ¬ (0 < (t : ℝ) ∧ (t : ℝ) < 1)) :
    ∃ v, G.pt e t = G.vertex v := by
  -- If `t = 0` it is the vertex `∂(e, 0)` (`pt_zero`); if `t = 1`, the vertex `∂(e, 1)`
  -- (`pt_one`); otherwise `0 < t < 1` (`interior_of_ne`), against `h`.
  by_cases h0 : (t : ℝ) = 0
  · refine ⟨G.ends (e, false), ?_⟩
    rw [← G.pt_zero e]
    exact congrArg (G.pt e) (Subtype.ext h0)
  · by_cases h1 : (t : ℝ) = 1
    · refine ⟨G.ends (e, true), ?_⟩
      rw [← G.pt_one e]
      exact congrArg (G.pt e) (Subtype.ext h1)
    · exact absurd (interior_of_ne h0 h1) h

/-- In `Γ ∖ {x}`, the points `y = G.pt e a` and `z = G.pt e b` of one edge `e` are joined by a
path, if no point `s` of `e` between `a` and `b` is `x` (`hx`). -/
theorem joined_edge {x : G.Space} (y z : ({x}ᶜ : Set G.Space)) (e : G.E) (a b : I)
    (hy : y.1 = G.pt e a) (hz : z.1 = G.pt e b)
    (hx : ∀ s : I, min (a : ℝ) b ≤ s → (s : ℝ) ≤ max (a : ℝ) b → G.pt e s ≠ x) :
    Joined y z := by
  -- Step 1. The segment `σ(t) = (1 - t) a + t b` stays in `[0, 1]` (`segment_bounds`), and is
  -- continuous into `I` (`continuous_segment`, `continuous_into_subspace`).
  have hI : ∀ t : I, (1 - (t : ℝ)) * a + (t : ℝ) * b ∈ I := fun t => by
    obtain ⟨h1, h2⟩ := segment_bounds a b t
    exact ⟨le_trans (le_min a.2.1 b.2.1) h1, le_trans h2 (max_le a.2.2 b.2.2)⟩
  let σ : I → I := fun t => ⟨_, hI t⟩
  have hσ : Continuous σ := continuous_into_subspace (continuous_segment a b) hI
  -- Step 2. The path is `t ↦ G.pt e (σ(t))`: it misses `x` by `hx`, is continuous
  -- (`continuous_pt`), and runs from `G.pt e a = y` to `G.pt e b = z`.
  have hne : ∀ t, G.pt e (σ t) ∈ ({x}ᶜ : Set G.Space) := fun t =>
    hx _ (segment_bounds a b t).1 (segment_bounds a b t).2
  refine ⟨fun t => ⟨G.pt e (σ t), hne t⟩,
    continuous_into_subspace ((G.continuous_pt e).comp hσ) hne, ?_, ?_⟩
  · apply Subtype.ext
    rw [hy]
    exact congrArg (G.pt e) (Subtype.ext (by simp [σ, I.zero]))
  · apply Subtype.ext
    rw [hz]
    exact congrArg (G.pt e) (Subtype.ext (by simp [σ, I.one]))

end Graph

/-- A space in which every point is joined by a path to one point `b` is connected. Mathlib:
`PathConnectedSpace.connectedSpace`. -/
theorem connected_of_joined_to {X : Type*} [TopSpace X] (b : X) (h : ∀ x, Joined x b) :
    Connected X := by
  -- Let `X = U ∪ V` with `U`, `V` open and disjoint. Every `x` is on `b`'s side
  -- (`Joined.mem_iff`): if `b ∈ U`, then `V = ∅`; if `b ∉ U`, then `U = ∅`.
  intro U V hU hV hUV hdisj
  by_cases hb : b ∈ U
  · right
    exact eq_empty_iff_forall_notMem.mpr fun x hxV =>
      hdisj.le_bot ⟨((h x).mem_iff hU hV hUV hdisj).mpr hb, hxV⟩
  · left
    exact eq_empty_iff_forall_notMem.mpr fun x hxU =>
      hb (((h x).mem_iff hU hV hUV hdisj).mp hxU)

/-- A point is joined to itself, by the constant path. Mathlib: `Joined.refl`. -/
theorem Joined.refl' {X : Type*} [TopSpace X] (x : X) : Joined x x :=
  ⟨fun _ => x, continuous_const, rfl, rfl⟩

/-- One vertex and one edge with both ends at it: the circle. `ex:graphs`. (Lean: `Unit` is the
one-point set `{()}`, and `ends _ := ()` sends every end to its point.) -/
def circleGraph : Graph where
  V := Unit
  E := Unit
  ends _ := ()

/-- Two vertices and one edge: `[0, 1]`. `ex:graphs`. The vertices are `false`, `true`, and
`∂(e, i) = i`: the edge runs from `false` to `true`. -/
def intervalGraph : Graph where
  V := Bool
  E := Unit
  ends p := p.2

/-- One vertex and two loops, `false` and `true`: the figure eight. `ex:graphs`. -/
def eightGraph : Graph where
  V := Unit
  E := Bool
  ends _ := ()

/-- Two vertices joined by three edges: the theta graph. `ex:graphs`. (`Fin 3` is `{0, 1, 2}`.) -/
def thetaGraph : Graph where
  V := Bool
  E := Fin 3
  ends p := p.2

/-- Two vertices joined by two edges: the circle again, with a redundant vertex. `ex:graphs`. -/
def circleGraph₂ : Graph where
  V := Bool
  E := Bool
  ends p := p.2

/-! ## The figure eight is not the circle (`ex:eight-vs-circle`) -/

section EightCircle

/-- The midpoint `1/2` of `[0, 1]` (`norm_num` checks `0 ≤ 1/2 ≤ 1`). -/
noncomputable def I.half : I := ⟨1 / 2, by norm_num, by norm_num⟩

/-- In the circle `circleGraph`, the complement of the vertex is connected. -/
theorem circle_compl_vertex_connected (v : circleGraph.V) :
    Connected ({circleGraph.vertex v}ᶜ : Set circleGraph.Space) := by
  -- We join every point `y` to the midpoint `1/2` of the edge (`connected_of_joined_to`); the
  -- midpoint is interior, so it is not the vertex (`pt_ne_vertex`).
  have hb : circleGraph.pt () I.half ∈ ({circleGraph.vertex v}ᶜ : Set circleGraph.Space) :=
    circleGraph.pt_ne_vertex (by norm_num [I.half]) (by norm_num [I.half]) v
  refine connected_of_joined_to ⟨_, hb⟩ fun y => ?_
  -- `y` is not a vertex: there is only one, `v`, and `y ≠ v` (`cases v` says `v` is `()`).
  rcases circleGraph.cases y.1 with ⟨v', hv'⟩ | ⟨e, t, ht⟩
  · exact absurd hv' (by cases v; cases v'; exact y.2)
  -- So `y` is the point `t` of the edge, and `t` is interior: an end would be the vertex.
  · have hint : 0 < (t : ℝ) ∧ (t : ℝ) < 1 := by
      by_contra hn
      obtain ⟨w, hw⟩ := circleGraph.pt_eq_vertex_of_not (e := e) hn
      apply y.2
      rw [ht, hw]
      cases v; cases w; rfl
    -- Join `t` to `1/2` along the edge (`joined_edge`): every `s` between them has
    -- `0 < min(t, 1/2) ≤ s ≤ max(t, 1/2) < 1`, so it is interior and not the vertex.
    cases e
    refine circleGraph.joined_edge y _ () t I.half ht rfl fun s hs1 hs2 => ?_
    have h1 : min (t : ℝ) (1 / 2) ≤ s := hs1
    have h2 : (s : ℝ) ≤ max (t : ℝ) (1 / 2) := hs2
    refine circleGraph.pt_ne_vertex ?_ ?_ v
    · linarith [lt_min hint.1 (by norm_num : (0 : ℝ) < 1 / 2)]
    · linarith [max_lt hint.2 (by norm_num : (1 / 2 : ℝ) < 1)]

/-- No point of the circle disconnects it: `S¹ ∖ {x}` is connected for every `x`.
`ex:eight-vs-circle`, the circle's half. -/
theorem circle_compl_connected (x : circleGraph.Space) :
    Connected ({x}ᶜ : Set circleGraph.Space) := by
  -- Case 1: `x` is the vertex: `circle_compl_vertex_connected`.
  rcases circleGraph.cases x with ⟨v, rfl⟩ | ⟨e, t₀, rfl⟩
  · exact circle_compl_vertex_connected v
  -- Case 2: `x` is the point `t₀` of the edge, not interior: then it is the vertex again.
  -- (Lean: `swap` takes the second of the two cases first.)
  by_cases hint : 0 < (t₀ : ℝ) ∧ (t₀ : ℝ) < 1
  swap
  · obtain ⟨v, hv⟩ := circleGraph.pt_eq_vertex_of_not (e := e) hint
    rw [hv]
    exact circle_compl_vertex_connected v
  -- Case 3: `0 < t₀ < 1`. We join every point `y ≠ x` to the vertex, which is not `x`.
  have hb : circleGraph.vertex () ∈ ({circleGraph.pt e t₀}ᶜ : Set circleGraph.Space) :=
    fun h => circleGraph.pt_ne_vertex hint.1 hint.2 () h.symm
  refine connected_of_joined_to ⟨_, hb⟩ fun y => ?_
  -- If `y` is the vertex, by the constant path.
  rcases circleGraph.cases y.1 with ⟨v', hv'⟩ | ⟨e', t, ht⟩
  · have : y = ⟨_, hb⟩ := Subtype.ext (by rw [hv']; cases v'; rfl)
    rw [this]
    exact Joined.refl' _
  · cases e; cases e'
    have hne : (t : ℝ) ≠ t₀ := fun h => y.2 (by rw [ht]; exact congrArg _ (Subtype.ext h))
    -- Otherwise `y` is the point `t ≠ t₀` of the edge. If `t < t₀`, go along the edge from `t`
    -- down to `0`, the vertex: every `s` on the way has `s ≤ t < t₀`, so it is not `x`
    -- (`pt_ne_pt`). If `t > t₀`, go up to `1`, the vertex again, with `s ≥ t > t₀`.
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · refine circleGraph.joined_edge y _ () t I.zero ht (circleGraph.pt_zero ()).symm ?_
      intro s hs1 hs2
      have : (s : ℝ) ≤ max (t : ℝ) 0 := hs2
      exact circleGraph.pt_ne_pt hint.1 hint.2
        (ne_of_lt (lt_of_le_of_lt this (max_lt hlt hint.1)))
    · refine circleGraph.joined_edge y _ () t I.one ht (circleGraph.pt_one ()).symm ?_
      intro s hs1 hs2
      have : min (t : ℝ) 1 ≤ s := hs1
      exact circleGraph.pt_ne_pt hint.1 hint.2
        (ne_of_gt (lt_of_lt_of_le (lt_min hgt hint.2) this))

/-- The sign `-1` on the loop `false`, `+1` on the loop `true` of the figure eight. -/
def eightSign (e : Bool) : ℝ := bif e then 1 else -1

/-- A height function on the figure eight: `±t(1 - t)` at the point `t` of the two loops, `0` at
the vertex. It is defined by the universal property of the pushout (`thm:pushout-top`,
`Pushout.desc`): at the ends `t = 0, 1` of the loops it is `0`, as at the vertex they are glued
to. -/
noncomputable def eightHeight : eightGraph.Space → ℝ :=
  Pushout.desc (fun _ => 0) (fun y => eightSign y.1 * ((y.2 : ℝ) * (1 - (y.2 : ℝ))))
    (fun p => by
      rcases p with ⟨e, b⟩
      cases b <;> simp [Graph.incl, Graph.endpt, I.zero, I.one])

/-- The height is continuous. `thm:pushout-top`: it is enough that it is continuous on `V` and
on `E × [0,1]`. -/
theorem continuous_eightHeight : Continuous eightHeight := by
  -- On `V` it is constant. On `E × [0,1]` it is `(e, t) ↦ sign(e) · (t(1 - t))`: `sign(e)` is
  -- continuous since `E` is discrete (`continuous_of_discrete`), `t` and `1 - t` are, and
  -- products of continuous real functions are continuous (Analysis I, `continuous_mul_real`).
  refine continuous_pushout_desc continuous_const ?_ _
  have hσ : Continuous (fun y : eightGraph.E × I => eightSign y.1) :=
    (continuous_of_discrete (X := eightGraph.E) eightSign).comp continuous_fst
  have ht : Continuous (fun y : eightGraph.E × I => (y.2 : ℝ)) :=
    continuous_subtype_val.comp continuous_snd
  have h1t : Continuous (fun y : eightGraph.E × I => 1 - (y.2 : ℝ)) :=
    continuous_sub_real.comp (continuous_prodMk.mpr ⟨continuous_const_real 1, ht⟩)
  have hp : Continuous (fun y : eightGraph.E × I => (y.2 : ℝ) * (1 - (y.2 : ℝ))) :=
    continuous_mul_real.comp (continuous_prodMk.mpr ⟨ht, h1t⟩)
  exact continuous_mul_real.comp (continuous_prodMk.mpr ⟨hσ, hp⟩)

/-- Removing the vertex disconnects the figure eight. `ex:eight-vs-circle`, the figure eight's
half. -/
theorem eight_compl_vertex_not_connected :
    ¬ Connected ({eightGraph.vertex ()}ᶜ : Set eightGraph.Space) := by
  -- Apply `not_connected_of_real` to the height `h` and `c = 0`: off the vertex `h ≠ 0`, at the
  -- midpoint of the loop `false` it is `-1/4 < 0`, and at that of the loop `true` it is
  -- `1/4 > 0`. Three goals remain, in this order.
  have hhalf0 : 0 < ((I.half : I) : ℝ) := by norm_num [I.half]
  have hhalf1 : ((I.half : I) : ℝ) < 1 := by norm_num [I.half]
  refine not_connected_of_real (e := fun w : ({eightGraph.vertex ()}ᶜ : Set eightGraph.Space) =>
      eightHeight w.1) (continuous_eightHeight.comp continuous_subtype_val) (c := 0) ?_
    (a := ⟨eightGraph.pt false I.half, eightGraph.pt_ne_vertex hhalf0 hhalf1 ()⟩)
    (b := ⟨eightGraph.pt true I.half, eightGraph.pt_ne_vertex hhalf0 hhalf1 ()⟩) ?_ ?_
  -- Goal 1: `h(w) ≠ 0` for `w` not the vertex. `w` is the point `t` of a loop `e`; if
  -- `0 < t < 1`, then `t(1 - t) > 0`, and `±t(1 - t) ≠ 0`; otherwise `w` would be the vertex.
  · rintro ⟨w, hw⟩
    rcases eightGraph.cases w with ⟨v, rfl⟩ | ⟨e, t, rfl⟩
    · exact absurd (by cases v; rfl) hw
    by_cases hint : 0 < (t : ℝ) ∧ (t : ℝ) < 1
    · change eightSign e * ((t : ℝ) * (1 - (t : ℝ))) ≠ 0
      have hp : 0 < (t : ℝ) * (1 - (t : ℝ)) := mul_pos hint.1 (by linarith [hint.2])
      cases e
      · have : eightSign false * ((t : ℝ) * (1 - (t : ℝ))) < 0 := by
          simp only [eightSign, Bool.cond_false]; linarith
        exact ne_of_lt this
      · have : 0 < eightSign true * ((t : ℝ) * (1 - (t : ℝ))) := by
          simp only [eightSign, Bool.cond_true]; linarith
        exact ne_of_gt this
    · obtain ⟨v, hv⟩ := eightGraph.pt_eq_vertex_of_not (e := e) hint
      exact absurd (by rw [hv]; cases v; rfl) hw
  -- Goals 2 and 3: `h = -1/4` and `h = 1/4` at the two midpoints.
  · change eightSign false * ((1 / 2 : ℝ) * (1 - 1 / 2)) < 0
    norm_num [eightSign]
  · change 0 < eightSign true * ((1 / 2 : ℝ) * (1 - 1 / 2))
    norm_num [eightSign]

/-- **`ex:eight-vs-circle`**: the figure eight is not homeomorphic to the circle. Mathlib: none.

The book separates them by degree (`def:degree`, `prop:degree-invariant`): the vertex of the
figure eight has degree `4`, every point of the circle degree `2`. Here they are separated by the
coarser invariant behind it, the one of `thm:one-dimensional`: removing the vertex disconnects
the figure eight, while no point disconnects the circle, and a homeomorphism carries `X ∖ {x}`
onto `Y ∖ {h(x)}`. -/
theorem eight_not_homeomorph_circle :
    ¬ Nonempty (Homeomorph eightGraph.Space circleGraph.Space) := by
  -- Suppose `h` is a homeomorphism from the figure eight to the circle, and let `v` be the
  -- vertex. The circle minus `h(v)` is connected (`circle_compl_connected`), so its image under
  -- `h⁻¹`, the figure eight minus `h⁻¹(h(v)) = v`, is connected (`connected_compl`); but it is
  -- not (`eight_compl_vertex_not_connected`).
  rintro ⟨h⟩
  have := h.inv.connected_compl (h.toEquiv (eightGraph.vertex ()))
    (circle_compl_connected _)
  have e : h.inv.toEquiv (h.toEquiv (eightGraph.vertex ())) = eightGraph.vertex () :=
    h.toEquiv.symm_apply_apply _
  rw [e] at this
  exact eight_compl_vertex_not_connected this

end EightCircle

