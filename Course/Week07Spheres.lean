-- Bookkeeping. `X`, `Y` below are spaces (types; `u v` are their "universe levels", which you
-- may ignore), and `noncomputable section` says that some definitions use real numbers, which
-- Lean cannot compute.
universe u v

set_option warn.classDefReducibility false

namespace Course

open Set

noncomputable section

variable {X : Type u} {Y : Type v}

/-! ## Pieces of a path

The book cuts a path `f` at `0 = s₀ < s₁ < ⋯ < sₘ = 1` and reparametrises each piece. Here the
piece of `f` from time `a` to time `b` is `f` read along the straight path from `a` to `b` in
`I`; two pieces in a row make the piece from the first time to the last, up to homotopy. -/

namespace I

/-- The straight path from `a` to `b` inside `I`, `σ ↦ (1 - σ) a + σ b`; it stays in `I` because
`I` is convex. (It is week 4's straight-line homotopy `I.line` between the constant maps `a`
and `b`, read along its left edge.) -/
def seg (a b : I) : Path a b where
  toFun σ := line (fun _ => a) (fun _ => b) (0, σ)
  continuous_toFun := (continuous_line continuous_const continuous_const).comp
    (continuous_const.prodMk continuous_id)
  source' := line_zero _ _ 0
  target' := line_one _ _ 0

/-- Unfolding: `seg a b σ = (1 - σ) a + σ b`. -/
theorem coe_seg (a b σ : I) : (seg a b σ : ℝ) = (1 - (σ : ℝ)) * a + σ * b := rfl

/-- Any two paths `p`, `q` in `I` with the same ends `a`, `b` are homotopic rel ends, by the
straight-line homotopy `(s, t) ↦ (1 - t) p(s) + t q(s)`, which stays in `I` as `I` is convex.
The idea of `lem:reparam`. Mathlib: `Path.Homotopic` in a convex set (no single name). -/
theorem paths_homotopic {a b : I} (p q : Path a b) : p.Homotopic q :=
  -- Bottom edge `p`, top edge `q`; the left edge is `(1 - t) a + t a = a`, the right edge
  -- `(1 - t) b + t b = b`. (Lean: `{ field := … }` builds the homotopy field by field.)
  ⟨{ toFun := line p q
     continuous_toFun := continuous_line p.continuous q.continuous
     zero' := line_zero p q
     one' := line_one p q
     source' := fun t => Subtype.ext (by simp [p.source, q.source]; ring)
     target' := fun t => Subtype.ext (by simp [p.target, q.target]; ring) }⟩

end I

section Pieces
variable [TopSpace X]

/-- The piece of the path `f` from time `a` to time `b`: the path `σ ↦ f((1 - σ) a + σ b)`, from
`f(a)` to `f(b)`. The book's `fᵢ`, "the restriction of `f` to `[sᵢ₋₁, sᵢ]`, reparametrised".
Mathlib: `Path.truncate`.

The hypotheses `hy : f a = y` and `hy' : f b = y'` let us name its ends as we like. -/
def Path.sub {x x' : X} (f : Path x x') (a b : I) {y y' : X} (hy : f a = y) (hy' : f b = y') :
    Path y y' :=
  (I.seg a b).map f.continuous hy hy'

/-- Unfolding: the piece from `a` to `b` at time `σ` is `f((1 - σ) a + σ b)`. -/
theorem Path.sub_apply {x x' : X} (f : Path x x') (a b : I) {y y' : X} (hy : f a = y)
    (hy' : f b = y') (σ : I) : f.sub a b hy hy' σ = f (I.seg a b σ) := rfl

/-- `[f|[a, b]] [f|[b, c]] = [f|[a, c]]`: the piece from `a` to `b` followed by the piece from
`b` to `c` is homotopic rel ends to the piece from `a` to `c`. (No order of `a`, `b`, `c` is
needed.) -/
theorem Path.sub_trans {x x' : X} (f : Path x x') (a b c : I) {y y' y'' : X} (hy : f a = y)
    (hy' : f b = y') (hy'' : f c = y'') :
    ((f.sub a b hy hy').trans (f.sub b c hy' hy'')).Homotopic (f.sub a c hy hy'') := by
  -- The left side is `f ∘ (seg a b · seg b c)` (`Path.map_trans`, `prop:induced`), the right side
  -- `f ∘ seg a c`. The two paths of `I` are homotopic (`I.paths_homotopic`), and `f ∘` keeps
  -- homotopies (`Path.Homotopic.map`).
  rw [Path.sub, Path.sub, ← Path.map_trans]
  exact (I.paths_homotopic _ _).map f.continuous hy hy''

/-- The piece of `f` from `0` to `1` is `f` itself: `f((1 - σ) · 0 + σ · 1) = f(σ)`. -/
theorem Path.sub_zero_one {x x' : X} (f : Path x x') : f.sub 0 1 f.source f.target = f := by
  ext σ
  show f (I.seg 0 1 σ) = f σ
  apply f.congr_coe
  rw [I.coe_seg]; simp

/-- The path `g` lies in the set `W`: `g(σ) ∈ W` for every `σ`. -/
def Path.LiesIn {y y' : X} (g : Path y y') (W : Set X) : Prop := ∀ σ, g σ ∈ W

/-- If `g` and `g'` lie in `W`, so does `g · g'`: each of its values is a value of `g` or of
`g'` (`def:concatenation`). -/
theorem Path.LiesIn.trans {y y' y'' : X} {g : Path y y'} {g' : Path y' y''} {W : Set X}
    (hg : g.LiesIn W) (hg' : g'.LiesIn W) : (g.trans g').LiesIn W := by
  intro σ
  rw [Path.trans_apply]
  split_ifs
  · exact hg _
  · exact hg' _

/-- If `g` lies in `W`, so does its reverse `ḡ`, which has the same values. -/
theorem Path.LiesIn.symm {y y' : X} {g : Path y y'} {W : Set X} (hg : g.LiesIn W) :
    g.symm.LiesIn W := fun _ => hg _

/-- If `a ≤ b` and `f` carries `[a, b]` into `W` (`hW`), the piece of `f` from `a` to `b` lies
in `W`: `(1 - σ) a + σ b` is in `[a, b]`. -/
theorem Path.liesIn_sub {x x' : X} (f : Path x x') {a b : I} (hab : (a : ℝ) ≤ b) {y y' : X}
    (hy : f a = y) (hy' : f b = y') {W : Set X}
    (hW : ∀ s : I, (a : ℝ) ≤ s → (s : ℝ) ≤ b → f s ∈ W) : (f.sub a b hy hy').LiesIn W := by
  intro σ
  -- `a ≤ (1 - σ) a + σ b ≤ b` for `0 ≤ σ ≤ 1` (Analysis I).
  apply hW
  · rw [I.coe_seg]; nlinarith [σ.2.1, σ.2.2]
  · rw [I.coe_seg]; nlinarith [σ.2.1, σ.2.2]

/-- A loop `ℓ` at `x` lying in `W` has its class in the image of `i_* : π₁(W, x) → π₁(X, x)`,
for the inclusion `i : W → X` (`prop:induced`): it is `i_*` of the class of `ℓ` seen as a loop
in `W`. Mathlib: `FundamentalGroup.map`.

Lean: `Set.range F` is the image of the map `F`; `⟨x, hx⟩` is `x` as a point of `W`. -/
theorem mem_range_induced {W : Set X} {x : X} (hx : x ∈ W) {ℓ : Path x x} (hℓ : ℓ.LiesIn W) :
    (⟦ℓ⟧ : pi1 x) ∈ Set.range (induced (Subtype.val : W → X) continuous_subtype_val
      (rfl : ((⟨x, hx⟩ : W) : X) = x)) := by
  -- `ℓ` as a loop in `W`: `σ ↦ ℓ(σ)`, continuous into the subspace `W` (`prop-1-15`); and
  -- `i ∘ ℓ = ℓ`.
  refine ⟨⟦⟨fun σ => ⟨ℓ σ, hℓ σ⟩, continuous_into_subspace ℓ.continuous hℓ,
    Subtype.ext ℓ.source, Subtype.ext ℓ.target⟩⟧, ?_⟩
  rw [induced_mk]
  congr 1

end Pieces

/-! ## The Lebesgue grid -/

/-- The Lebesgue number lemma on `I` (Analysis I: `I` is compact, Mathlib's
`lebesgue_number_lemma_of_metric`, through `isOpen_I_iff`), for the cover of `I` by `f⁻¹(U)`
and `f⁻¹(V)`: for some `N ≥ 1`, `f` carries each `[j/N, (j + 1)/N]`, `j < N`, into `U` or into
`V`. As week 6's `exists_grid_I`, for two open sets instead of the arcs. -/
theorem exists_grid_cover [TopSpace X] {f : I → X} (hf : Continuous f) {U V : Set X}
    (hU : IsOpen U) (hV : IsOpen V) (hUV : ∀ y, y ∈ U ∨ y ∈ V) :
    ∃ N : ℕ, 0 < N ∧ ∀ j : ℕ, j < N →
      (∀ s : I, (j : ℝ) / N ≤ s → (s : ℝ) ≤ ((j : ℝ) + 1) / N → f s ∈ U) ∨
      (∀ s : I, (j : ℝ) / N ≤ s → (s : ℝ) ≤ ((j : ℝ) + 1) / N → f s ∈ V) := by
  -- The two sets `f⁻¹(U)`, `f⁻¹(V)` (Lean: indexed by `b : Bool`, `cond b U V` is `U` for
  -- `b = true` and `V` for `b = false`) are open and cover `I`; so there is `δ > 0` such that
  -- every ball `B(s, δ)` of `I` lies in one of them (Analysis I).
  obtain ⟨δ, hδ, hball⟩ := lebesgue_number_lemma_of_metric (isCompact_univ (X := unitInterval))
    (c := fun b : Bool => f ⁻¹' (cond b U V))
    (fun b => by cases b <;> exact (isOpen_I_iff _).mp (hf _ ‹_›))
    (fun s _ => by
      rcases hUV (f s) with h | h
      · exact mem_iUnion.mpr ⟨true, h⟩
      · exact mem_iUnion.mpr ⟨false, h⟩)
  -- Take `N = n + 1` with `1/(n + 1) < δ` (Analysis I: the Archimedean property).
  obtain ⟨n, hn⟩ := exists_nat_one_div_lt hδ
  refine ⟨n + 1, n.succ_pos, fun j hj => ?_⟩
  obtain ⟨h0, h01, h1⟩ := grid_facts n.succ_pos hj
  -- The ball of radius `δ` about `j/N` lies in `f⁻¹(U)` or in `f⁻¹(V)`; every `s` in
  -- `[j/N, (j + 1)/N]` is within `1/N < δ` of `j/N`.
  obtain ⟨b, hb⟩ := hball (I.pt ((j : ℝ) / (n + 1 : ℕ))) (mem_univ _)
  have key : ∀ s : I, (j : ℝ) / (n + 1 : ℕ) ≤ s → (s : ℝ) ≤ ((j : ℝ) + 1) / (n + 1 : ℕ) →
      f s ∈ cond b U V := by
    intro s hs1 hs2
    apply hb
    have e : ((j : ℝ) + 1) / (n + 1 : ℕ) = (j : ℝ) / (n + 1 : ℕ) + 1 / ((n : ℝ) + 1) := by
      push_cast; ring
    rw [Metric.mem_ball, Subtype.dist_eq, Real.dist_eq, I.coe_pt h0 (h01.trans h1), abs_lt]
    constructor <;> linarith
  cases b
  · exact Or.inr key
  · exact Or.inl key

/-! ## The generation lemma (`thm:generation`, `fig-6-generation`) -/

/-- The classes that `thm:generation` (1) is about: products `[g₁][g₂]⋯[gₘ]` of classes of paths
`gᵢ` between points of `A`, each lying in `U` or in `V`. Built from the empty product `[c_a]`
(`refl`) by multiplying on the right by one more such class (`step`). Mathlib: none.

Lean: an `inductive` predicate is the smallest one closed under its rules; to prove that every
class with the property has another property, one checks the rules (induction on the rules). -/
inductive GenClass (U V A : Set X) [TopSpace X] : {a b : X} → PathClass a b → Prop
  /-- The empty product, the identity `[c_a]`. -/
  | refl (a : X) : GenClass U V A (PathClass.refl a)
  /-- If `w` is such a product ending at `b ∈ A`, and `g` is a path from `b` to `c ∈ A` lying in
  `U` or in `V`, then `w [g]` is one. -/
  | step {a b c : X} {w : PathClass a b} (hw : GenClass U V A w) (hb : b ∈ A) (hc : c ∈ A)
      (g : Path b c) (hg : g.LiesIn U ∨ g.LiesIn V) : GenClass U V A (PathClass.comp w ⟦g⟧)

/-- **`thm:generation`** (1): let `X = U ∪ V` (`hUV`) with `U`, `V` open, and `A ⊆ U ∩ V` (`hA`)
meet every path component of `U ∩ V` (`hAc`: each `y ∈ U ∩ V` is joined inside `U ∩ V` to some
`a ∈ A`). Then every path class from `a ∈ A` to `b ∈ A` is a product of classes of paths between
points of `A`, each lying in `U` or in `V`. Mathlib: none (no Seifert–van Kampen theorem for
fundamental groups in v4.34.1).

The book's proof: cut `f` along a Lebesgue grid into pieces `fᵢ` lying in `U` or `V`, join the
cut points in `U ∩ V` to `A` by paths `gᵢ` inside `U ∩ V`, and write
`[f] = [g₀ f₁ ḡ₁][g₁ f₂ ḡ₂]⋯[gₘ₋₁ fₘ ḡₘ]`. Here the product is built from the left, one grid
interval at a time. -/
theorem generation_groupoid [TopSpace X] {U V A : Set X} (hU : IsOpen U) (hV : IsOpen V)
    (hUV : ∀ y, y ∈ U ∨ y ∈ V) (hA : A ⊆ U ∩ V)
    (hAc : ∀ y (hy : y ∈ U ∩ V), ∃ a, ∃ ha : a ∈ A,
      Nonempty (Path (⟨y, hy⟩ : (U ∩ V : Set X)) ⟨a, hA ha⟩))
    {a b : X} (ha : a ∈ A) (hb : b ∈ A) (f : Path a b) :
    GenClass U V A (⟦f⟧ : PathClass a b) := by
  -- Below, `W` is always `U` or `V`, and `U ∩ V ⊆ W`.
  have hUVW : ∀ W, (W = U ∨ W = V) → U ∩ V ⊆ W := by
    rintro W (rfl | rfl)
    · exact inter_subset_left
    · exact inter_subset_right
  -- A path `g` from `a` to `c ∈ A` lying in `W` gives the one-factor product `[c_a][g] = [g]`.
  have hW : ∀ W, (W = U ∨ W = V) → ∀ {c : X} (g : Path a c), g.LiesIn W → c ∈ A →
      GenClass U V A (⟦g⟧ : PathClass a c) := by
    intro W hW' c g hg hc
    rw [← PathClass.id_comp (⟦g⟧ : PathClass a c)]
    refine GenClass.step (GenClass.refl a) ha hc g ?_
    rcases hW' with rfl | rfl
    · exact Or.inl hg
    · exact Or.inr hg
  -- Step 1. A grid `tⱼ = j/N`, `0 ≤ j ≤ N`, such that `f` carries each `[tⱼ, tⱼ₊₁]` into `U` or
  -- into `V` (Lebesgue number, `exists_grid_cover`).
  obtain ⟨N, hN, hgrid⟩ := exists_grid_cover f.continuous hU hV hUV
  obtain ⟨t, ht⟩ : ∃ t : ℕ → I, ∀ j, j ≤ N → (t j : ℝ) = j / N := by
    refine ⟨fun j => I.pt ((j : ℝ) / N), fun j hj => I.coe_pt (by positivity) ?_⟩
    exact (div_le_one (by exact_mod_cast hN)).mpr (by exact_mod_cast hj)
  -- Step 2. The claim, by induction on `j ≤ N`: for `W ∈ {U, V}`, `a' ∈ A` and any path `g`
  -- from `f(tⱼ)` to `a'` lying in `W`, the class `[f|[0, tⱼ] · g]` is such a product.
  have key : ∀ j, j ≤ N → ∀ W, (W = U ∨ W = V) → ∀ a' ∈ A, ∀ g : Path (f (t j)) a',
      g.LiesIn W →
        GenClass U V A (⟦(f.sub 0 (t j) f.source rfl).trans g⟧ : PathClass a a') := by
    intro j
    induction j with
    | zero =>
      -- `j = 0`: `f|[0, t₀]` stays at `f(0) = a ∈ W`, so `f|[0, t₀] · g` is one path from `a`
      -- to `a'` lying in `W`.
      intro _ W hW' a' ha' g hg
      have ht0 : (t 0 : ℝ) = 0 := by rw [ht 0 (Nat.zero_le _)]; simp
      refine hW W hW' _
        (Path.LiesIn.trans (Path.liesIn_sub _ (by rw [ht0]; simp) _ _ ?_) hg) ha'
      intro s hs1 hs2
      rw [f.congr_coe (show (s : ℝ) = ((0 : I) : ℝ) by
        rw [ht0] at hs2; apply le_antisymm (by simpa using hs2); simpa using s.2.1), f.source]
      exact hUVW W hW' (hA ha)
    | succ j ih =>
      -- `j → j + 1`: let `g` run from `f(tⱼ₊₁)` to `a' ∈ A` inside `W`. The piece
      -- `fⱼ = f|[tⱼ, tⱼ₊₁]` lies in `U` or in `V`, and `[f|[0, tⱼ]][fⱼ] = [f|[0, tⱼ₊₁]]`.
      intro hj W hW' a' ha' g hg
      obtain ⟨h0, h01, h1⟩ := grid_facts hN hj
      have htj : (t j : ℝ) = j / N := ht j (by omega)
      have htj' : (t (j + 1) : ℝ) = ((j : ℝ) + 1) / N := by
        rw [ht (j + 1) hj]; push_cast; ring
      have hpiece : ∀ W' : Set X, (∀ s : I, (j : ℝ) / N ≤ s → (s : ℝ) ≤ ((j : ℝ) + 1) / N →
          f s ∈ W') → (f.sub (t j) (t (j + 1)) rfl rfl).LiesIn W' := fun W' hp =>
        Path.liesIn_sub f (by rw [htj, htj']; exact h01) rfl rfl
          (fun s hs1 hs2 => hp s (htj ▸ hs1) (htj' ▸ hs2))
      have hsplit : PathClass.comp (⟦f.sub 0 (t j) f.source rfl⟧ : PathClass a (f (t j)))
          ⟦f.sub (t j) (t (j + 1)) rfl rfl⟧ = ⟦f.sub 0 (t (j + 1)) f.source rfl⟧ :=
        Quotient.sound (Path.sub_trans f 0 (t j) (t (j + 1)) f.source rfl rfl)
      by_cases hmid : f (t (j + 1)) ∈ U ∩ V
      · -- Case 1: `f(tⱼ₊₁) ∈ U ∩ V`. Join it inside `U ∩ V` to some `a'' ∈ A` by a path `k`
        -- (this is where the hypothesis on `A` is used); `fⱼ` lies in some `W' ∈ {U, V}`.
        obtain ⟨a'', ha'', ⟨k₀⟩⟩ := hAc _ hmid
        let k : Path (f (t (j + 1))) a'' := k₀.map continuous_subtype_val rfl rfl
        have hk : ∀ W, (W = U ∨ W = V) → k.LiesIn W := fun W hW' σ => hUVW W hW' (k₀ σ).2
        obtain ⟨W', hW'', hpW'⟩ : ∃ W' : Set X, (W' = U ∨ W' = V) ∧ ∀ s : I, (j : ℝ) / N ≤ s →
            (s : ℝ) ≤ ((j : ℝ) + 1) / N → f s ∈ W' := by
          rcases hgrid j (by omega) with hp | hp
          · exact ⟨U, Or.inl rfl, hp⟩
          · exact ⟨V, Or.inr rfl, hp⟩
        -- By induction, for the path `fⱼ · k` in `W'`, `[f|[0, tⱼ] · fⱼ · k]` is a product;
        -- multiply by `[k̄ · g]`, a path from `a''` to `a'` lying in `W`.
        have h1' := ih (by omega) W' hW'' a'' ha'' ((f.sub (t j) (t (j + 1)) rfl rfl).trans k)
          ((hpiece W' hpW').trans (hk W' hW''))
        have hkg : (k.symm.trans g).LiesIn U ∨ (k.symm.trans g).LiesIn V := by
          rcases hW' with rfl | rfl
          · exact Or.inl ((hk _ (Or.inl rfl)).symm.trans hg)
          · exact Or.inr ((hk _ (Or.inr rfl)).symm.trans hg)
        have h2' := GenClass.step h1' ha'' ha' (k.symm.trans g) hkg
        -- And `[f|[0, tⱼ] fⱼ k][k̄ g] = [f|[0, tⱼ]][fⱼ][g] = [f|[0, tⱼ₊₁] g]`, since
        -- `[k][k̄] = 1` (`thm:groupoid-laws`).
        have heq : (⟦(f.sub 0 (t (j + 1)) f.source rfl).trans g⟧ : PathClass a a') =
            PathClass.comp ⟦(f.sub 0 (t j) f.source rfl).trans
              ((f.sub (t j) (t (j + 1)) rfl rfl).trans k)⟧ ⟦k.symm.trans g⟧ := by
          show _ = PathClass.comp (PathClass.comp ⟦f.sub 0 (t j) f.source rfl⟧
            (PathClass.comp ⟦f.sub (t j) (t (j + 1)) rfl rfl⟧ ⟦k⟧))
            (PathClass.comp (PathClass.inv ⟦k⟧) ⟦g⟧)
          rw [PathClass.comp_assoc, PathClass.comp_assoc, PathClass.comp_inv_comp,
            ← PathClass.comp_assoc, hsplit]
          rfl
        rw [heq]
        exact h2'
      · -- Case 2: `f(tⱼ₊₁) ∉ U ∩ V`. It lies in `W` (as `g(0)`) and in the set that contains
        -- `fⱼ`; so that set is `W`, and `fⱼ · g` is a path in `W` from `f(tⱼ)` to `a'`.
        have hpW : ∀ s : I, (j : ℝ) / N ≤ s → (s : ℝ) ≤ ((j : ℝ) + 1) / N → f s ∈ W := by
          have hg0 : f (t (j + 1)) ∈ W := g.source ▸ hg 0
          have hin : ∀ W' : Set X, (∀ s : I, (j : ℝ) / N ≤ s → (s : ℝ) ≤ ((j : ℝ) + 1) / N →
              f s ∈ W') → f (t (j + 1)) ∈ W' := fun W' hp =>
            hp _ (by rw [htj']; exact h01) (by rw [htj'])
          rcases hgrid j (by omega) with hp | hp <;> rcases hW' with rfl | rfl
          · exact hp
          · exact absurd ⟨hin _ hp, hg0⟩ hmid
          · exact absurd ⟨hg0, hin _ hp⟩ hmid
          · exact hp
        -- By induction `[f|[0, tⱼ] · fⱼ · g]` is a product, and it is `[f|[0, tⱼ₊₁] · g]`.
        have := ih (by omega) W hW' a' ha' ((f.sub (t j) (t (j + 1)) rfl rfl).trans g)
          ((hpiece W hpW).trans hg)
        have heq : (⟦(f.sub 0 (t (j + 1)) f.source rfl).trans g⟧ : PathClass a a') =
            ⟦(f.sub 0 (t j) f.source rfl).trans
              ((f.sub (t j) (t (j + 1)) rfl rfl).trans g)⟧ := by
          show _ = PathClass.comp ⟦f.sub 0 (t j) f.source rfl⟧
            (PathClass.comp ⟦f.sub (t j) (t (j + 1)) rfl rfl⟧ ⟦g⟧)
          rw [← PathClass.comp_assoc, hsplit]
          rfl
        rw [heq]
        exact this
  -- Step 3. `j = N`, `t_N = 1`, and `g` the constant path at `b` (which lies in `U`): the claim
  -- says that `[f|[0, 1] · c_b] = [f · c_b] = [f]` is a product.
  have hNN : (t N : ℝ) = 1 := by rw [ht N le_rfl]; exact div_self (by exact_mod_cast hN.ne')
  let c : Path (f (t N)) b := ⟨fun _ => b, continuous_const, by
    show b = f (t N)
    rw [f.congr_coe (show (t N : ℝ) = ((1 : I) : ℝ) by rw [hNN]; rfl), f.target], rfl⟩
  have hfin := key N le_rfl U (Or.inl rfl) b hb c (fun _ => (hA hb).1)
  have heq : (f.sub 0 (t N) f.source rfl).trans c = (f.sub 0 1 f.source f.target).trans
      (Path.refl b) := by
    ext σ
    rw [Path.trans_apply, Path.trans_apply]
    split_ifs
    · show f (I.seg 0 (t N) _) = f (I.seg 0 1 _)
      apply f.congr_coe
      rw [I.coe_seg, I.coe_seg, hNN]; rfl
    · rfl
  rw [heq, Path.sub_zero_one] at hfin
  rwa [show (⟦f.trans (Path.refl b)⟧ : PathClass a b) = ⟦f⟧ from
    Quotient.sound (Path.Homotopic.trans_refl f)] at hfin

/-- **`thm:generation`** (2): let `X = U ∪ V` (`hUV`) with `U`, `V` open, `U ∩ V` path-connected
(`hUVc`), and `x ∈ U ∩ V`. Then `π₁(X, x)` is generated by the images of `π₁(U, x)` and
`π₁(V, x)` under the inclusions (`prop:induced`). Mathlib: none in v4.34.1.

Lean: `Subgroup.closure S` is the subgroup generated by the set `S`, and `⊤` is the whole
group.

The book's proof: part (1) with `A = {x}`; then every factor is the class of a loop at `x` in
`U` or in `V`. -/
theorem generation [TopSpace X] {U V : Set X} (hU : IsOpen U) (hV : IsOpen V)
    (hUV : ∀ y, y ∈ U ∨ y ∈ V) (hUVc : PathConnected (U ∩ V : Set X)) {x : X} (hxU : x ∈ U)
    (hxV : x ∈ V) :
    Subgroup.closure (Set.range (induced (Subtype.val : U → X) continuous_subtype_val
        (rfl : ((⟨x, hxU⟩ : U) : X) = x)) ∪
      Set.range (induced (Subtype.val : V → X) continuous_subtype_val
        (rfl : ((⟨x, hxV⟩ : V) : X) = x))) = ⊤ := by
  have hA : ({x} : Set X) ⊆ U ∩ V := singleton_subset_iff.mpr ⟨hxU, hxV⟩
  -- Step 1. A product of classes of paths between points of `A = {x}`, each in `U` or in `V`,
  -- lies in the subgroup generated by the two images: it is a product of classes of loops at
  -- `x` in `U` or in `V` (`mem_range_induced`). By induction on the product. (Lean: the product
  -- is a priori a class from `a` to `b`; `cast` sees it as a loop class once `a = b = x`.)
  have hmem : ∀ {a b : X} {w : PathClass a b}, GenClass U V {x} w →
      ∀ (ha : a = x) (hb : b = x),
      (cast (by rw [ha, hb]) w : pi1 x) ∈ Subgroup.closure (Set.range (induced
        (Subtype.val : U → X) continuous_subtype_val (rfl : ((⟨x, hxU⟩ : U) : X) = x)) ∪
      Set.range (induced (Subtype.val : V → X) continuous_subtype_val
        (rfl : ((⟨x, hxV⟩ : V) : X) = x))) := by
    intro a b w hw
    induction hw with
    | refl =>
      -- The empty product is `1`.
      intro ha _
      subst ha
      exact Subgroup.one_mem _
    | step hw hb hc g hg ih =>
      -- `w [g]`: `w` is in the subgroup by induction, and `[g]` is the class of a loop at `x`
      -- lying in `U` or in `V`.
      intro ha hc'
      subst ha
      subst hc'
      rw [mem_singleton_iff] at hb
      subst hb
      refine Subgroup.mul_mem _ (ih rfl rfl) ?_
      rcases hg with hg | hg
      · exact Subgroup.subset_closure (Or.inl (mem_range_induced hxU hg))
      · exact Subgroup.subset_closure (Or.inr (mem_range_induced hxV hg))
  -- Step 2. Every `[f] ∈ π₁(X, x)` is such a product, by part (1) with `A = {x}`: `x` meets the
  -- only path component of `U ∩ V`.
  rw [Subgroup.eq_top_iff']
  intro a
  induction a using Quotient.ind with | _ f => ?_
  exact hmem (generation_groupoid hU hV hUV hA (fun y hy => ⟨x, rfl, hUVc.2 _ _⟩) rfl rfl f)
    rfl rfl

/-! ## Euclidean space and the spheres

`ℝⁿ` is Mathlib's `EuclideanSpace ℝ (Fin n)` (the points `(x₀, …, xₙ₋₁)`), with the topology of
the euclidean metric `d(x, y) = |x - y|` (`def-1-1`), and `Sⁿ` is the unit sphere of `ℝⁿ⁺¹` with
the subspace topology (`def-1-14`). The bridges say that these are Mathlib's topologies, so that
Mathlib's stereographic projection can be used. -/

/-- `ℝⁿ`, the space of `n`-tuples of real numbers. Mathlib: `EuclideanSpace ℝ (Fin n)`. -/
abbrev Rn (n : ℕ) : Type := EuclideanSpace ℝ (Fin n)

/-- The euclidean metric `d(x, y) = |x - y|` on `ℝⁿ` (Analysis I). Mathlib: `EuclideanSpace`'s
`dist` (`EuclideanSpace.dist_eq`). -/
def euclidMetric (n : ℕ) : PseudoMetric (Rn n) where
  d x y := dist x y
  nonneg _ _ := dist_nonneg
  self _ := dist_self _
  symm _ _ := dist_comm _ _
  triangle _ _ _ := dist_triangle _ _ _

/-- The topology of `ℝⁿ`: that of the euclidean metric. Mathlib: `EuclideanSpace`'s topology
(see `euclid_toMathlib`). -/
instance euclid (n : ℕ) : TopSpace (Rn n) := (euclidMetric n).toTopSpace

/-- **Bridge.** The topology of `ℝⁿ` is Mathlib's. Mathlib: `Metric.isOpen_iff`. -/
theorem euclid_toMathlib (n : ℕ) :
    (euclid n).toMathlib = (inferInstance : TopologicalSpace (Rn n)) := by
  -- Both say: `U` is open iff it contains a ball about each of its points; Mathlib's ball
  -- `{y | d(y, x) < ε}` is ours, `{y | d(x, y) < ε}`, by symmetry.
  apply TopologicalSpace.ext
  funext U
  apply propext
  change @IsOpen _ (euclidMetric n).toTopSpace U ↔ _
  rw [(euclidMetric n).isOpen_iff, Metric.isOpen_iff]
  have hball : ∀ x ε, Metric.ball x ε = (euclidMetric n).ball x ε := by
    intro x ε; ext y
    change dist y x < ε ↔ dist x y < ε
    rw [dist_comm]
  simp only [hball]

/-- **Bridge.** If the topology of `X` is Mathlib's topology `m`, the subspace topology of
`A ⊆ X` is Mathlib's subspace topology for `m` (`subspace_toMathlib`). -/
theorem subspace_toMathlib_of [TopSpace X] {m : TopologicalSpace X}
    (h : (‹TopSpace X›).toMathlib = m) (A : Set X) :
    (subspace A).toMathlib = @instTopologicalSpaceSubtype X A m := by
  rw [subspace_toMathlib, h]

/-- The sphere `Sⁿ = {x ∈ ℝⁿ⁺¹ : |x| = 1}`, with the subspace topology. Mathlib:
`Metric.sphere (0 : EuclideanSpace ℝ (Fin (n + 1))) 1`. -/
abbrev Sphere (n : ℕ) : Set (Rn (n + 1)) := Metric.sphere 0 1

/-- **Bridge.** The topology of `Sⁿ` is Mathlib's. -/
theorem sphere_toMathlib (n : ℕ) :
    (subspace (Sphere n)).toMathlib = (inferInstance : TopologicalSpace (Sphere n)) :=
  subspace_toMathlib_of (euclid_toMathlib _) _

/-- **Bridge.** The topology of a subset of `Sⁿ` is Mathlib's. -/
theorem sphereSub_toMathlib (n : ℕ) (A : Set (Sphere n)) :
    (subspace A).toMathlib = (inferInstance : TopologicalSpace A) :=
  subspace_toMathlib_of (sphere_toMathlib n) A

/-- **Bridge.** The topology of `ℝⁿ ∖ {p}` is Mathlib's. -/
theorem compl_toMathlib (n : ℕ) (p : Rn n) :
    (subspace ({p}ᶜ : Set (Rn n))).toMathlib =
      (inferInstance : TopologicalSpace ({p}ᶜ : Set (Rn n))) :=
  subspace_toMathlib_of (euclid_toMathlib _) _

/-- **Bridge.** The topology of `ℝⁿ × I` is Mathlib's (`prod_toMathlib`, `I_toMathlib`). -/
theorem RnI_toMathlib (n : ℕ) :
    (prod : TopSpace (Rn n × I)).toMathlib = (inferInstance : TopologicalSpace (Rn n × I)) := by
  rw [prod_toMathlib, euclid_toMathlib, I_toMathlib]

/-- **Bridge.** A Mathlib homeomorphism, for topologies that are those of the course (`hX`,
`hY`), is a homeomorphism of the course (`Homeomorph.ofMathlib`). -/
def homeomorphOfMathlib [tX : TopSpace X] [tY : TopSpace Y] {mX : TopologicalSpace X}
    {mY : TopologicalSpace Y} (hX : tX.toMathlib = mX) (hY : tY.toMathlib = mY)
    (h : @_root_.Homeomorph X Y mX mY) : Homeomorph X Y := by
  subst hX hY; exact Homeomorph.ofMathlib h

/-- **Bridge.** A space path-connected in Mathlib's sense, for a topology that is that of the
course (`h`), is path-connected (`def:simply-connected`): Mathlib's paths are the course's
(`Path.ofMathlib`). Mathlib: `PathConnectedSpace`. -/
theorem pathConnected_of_mathlib [t : TopSpace X] {m : TopologicalSpace X} (h : t.toMathlib = m)
    (hX : @PathConnectedSpace X m) : PathConnected X := by
  subst h
  exact ⟨hX.nonempty,
    fun x y => ⟨Path.ofMathlib (@PathConnectedSpace.somePath X t.toMathlib hX x y)⟩⟩

/-- `ℝⁿ⁺¹` has dimension `n + 1`, which Mathlib's stereographic projection asks for.
Mathlib: `finrank_euclideanSpace_fin`. -/
instance fact_finrank (n : ℕ) : Fact (Module.finrank ℝ (Rn (n + 1)) = n + 1) :=
  ⟨finrank_euclideanSpace_fin⟩

/-- **`prop:stereographic`**: for every `q ∈ Sⁿ`, stereographic projection from `q` is a
homeomorphism `Sⁿ ∖ {q} ≅ ℝⁿ`. Mathlib: `stereographic'` (an open partial homeomorphism of `Sⁿ`
with source `Sⁿ ∖ {q}` and target `ℝⁿ`), transferred through the bridges. -/
def stereo (n : ℕ) (q : Sphere n) : Homeomorph ({q}ᶜ : Set (Sphere n)) (Rn n) :=
  -- Mathlib's projection is a homeomorphism from its source `Sⁿ ∖ {q}` onto its target `ℝⁿ`
  -- (`toHomeomorphSourceTarget`, `setCongr`, `Set.univ`).
  homeomorphOfMathlib (sphereSub_toMathlib n _) (euclid_toMathlib n)
    ((Homeomorph.setCongr (stereographic'_source q).symm).trans
      ((stereographic' n q).toHomeomorphSourceTarget.trans
        ((Homeomorph.setCongr (stereographic'_target q)).trans (Homeomorph.Set.univ _))))

/-- `ℝⁿ` is contractible (`def:contractible`): `H(x, t) = (1 - t) x` is a homotopy from the
identity to the constant map `0`. Mathlib: `Convex.contractibleSpace`. -/
theorem contractible_Rn (n : ℕ) : Contractible (Rn n) := by
  -- `H(x, 0) = x`, `H(x, 1) = 0`; `H` is continuous by Analysis I, through `RnI_toMathlib`.
  refine ⟨0, ⟨{ toFun := fun q => (1 - (q.2 : ℝ)) • q.1
                continuous_toFun := ?_
                zero' := fun x => by simp
                one' := fun x => by simp }⟩⟩
  refine continuous_of_mathlib_eq (RnI_toMathlib n) (euclid_toMathlib n) ?_
  exact (_root_.continuous_const.sub (_root_.continuous_subtype_val.comp
    _root_.continuous_snd)).smul _root_.continuous_fst

/-- A space homeomorphic to a contractible space is contractible (`def:contractible`): if `H`
contracts `Y` to `c` and `h : X ≅ Y`, then `(x, t) ↦ h⁻¹(H(h(x), t))` contracts `X` to
`h⁻¹(c)`. Mathlib: `Homeomorph.contractibleSpace_iff`. -/
theorem Homeomorph.contractible [TopSpace X] [TopSpace Y] (h : Homeomorph X Y)
    (hY : Contractible Y) : Contractible X := by
  obtain ⟨c, ⟨H⟩⟩ := hY
  refine ⟨h.invFun c, ⟨?_⟩⟩
  -- Continuous as a composite (`prop-1n-composite`); at `t = 0` it is `h⁻¹(h(x)) = x`, at
  -- `t = 1` it is `h⁻¹(c)`.
  refine { toFun := fun q => h.invFun (H.toFun (h.toFun q.1, q.2))
           continuous_toFun := h.continuous_invFun.comp (H.continuous_toFun.comp
             ((h.continuous_toFun.comp continuous_fst).prodMk continuous_snd))
           zero' := fun x => ?_
           one' := fun x => ?_ }
  · show h.invFun (H.toFun (h.toFun x, 0)) = x
    rw [H.zero']; exact h.left_inv x
  · show h.invFun (H.toFun (h.toFun x, 1)) = h.invFun c
    rw [H.one']

namespace Sphere

/-- The north pole `N = (1, 0, …, 0)` of `Sⁿ`; the south pole is `S = -N`. -/
def north (n : ℕ) : Sphere n := ⟨EuclideanSpace.single 0 1, by simp⟩

/-- `N ≠ S`: a point `v` with `v = -v` is `0`, which is not on the sphere. Mathlib:
`ne_neg_of_mem_sphere`. -/
theorem north_ne_neg (n : ℕ) : north n ≠ -north n := ne_neg_of_mem_sphere ℝ one_ne_zero _

/-- `Sⁿ ∖ {q}` is open in `Sⁿ`: points of `Sⁿ` are closed (Analysis I: a metric space is
Hausdorff; Mathlib's `isOpen_compl_singleton`, through `sphere_toMathlib`). -/
theorem isOpen_compl (n : ℕ) (q : Sphere n) : IsOpen ({q}ᶜ : Set (Sphere n)) := by
  rw [isOpen_iff_mathlib, sphere_toMathlib]; exact isOpen_compl_singleton

/-- For `n ≥ 2`, `U ∩ V = Sⁿ ∖ {N, S}` is path-connected, as the proof of `thm:spheres-sc` says:
the projection from `N` carries it onto `ℝⁿ ∖ {0}`, which is path-connected for `n ≥ 2`
(Mathlib: `isPathConnected_compl_singleton_of_one_lt_rank`). Proved in Mathlib's language and
transferred by `pathConnected_of_mathlib`. -/
theorem pathConnected_inter (n : ℕ) (hn : 2 ≤ n) :
    PathConnected (({north n}ᶜ ∩ {-north n}ᶜ : Set (Sphere n)) : Type) := by
  apply pathConnected_of_mathlib (sphereSub_toMathlib n _)
  rw [← isPathConnected_iff_pathConnectedSpace]
  -- `e` is the projection from `N`, defined on `Sⁿ ∖ {N}`, onto `ℝⁿ`; it sends `S` to `0`
  -- (Mathlib: `stereographic_apply_neg`), and its inverse `e⁻¹ : ℝⁿ → Sⁿ` is continuous.
  set e := stereographic' n (north n) with he
  have hneg : e (-north n) = 0 := by rw [he]; simp [stereographic', stereographic_apply_neg]
  have hsrc : ∀ y : Sphere n, y ∈ e.source ↔ y ≠ north n := fun y => by
    rw [he, stereographic'_source]; rfl
  have htgt : ∀ w, w ∈ e.target := fun w => by rw [he, stereographic'_target]; trivial
  have hcont : _root_.Continuous e.symm := by
    rw [← continuousOn_univ]
    have := e.continuousOn_symm
    rwa [he, stereographic'_target] at this
  -- `e⁻¹(ℝⁿ ∖ {0}) = Sⁿ ∖ {N, S}`, since `e⁻¹` is a bijection `ℝⁿ → Sⁿ ∖ {N}` with `e⁻¹(0) = S`.
  have himage : e.symm '' ({0}ᶜ) = {north n}ᶜ ∩ {-north n}ᶜ := by
    ext y
    constructor
    · rintro ⟨w, hw, rfl⟩
      refine ⟨(hsrc _).mp (e.map_target (htgt w)), fun h => hw ?_⟩
      have := e.right_inv (htgt w)
      rw [h, hneg] at this
      exact this.symm
    · rintro ⟨h1, h2⟩
      refine ⟨e y, fun h0 => h2 ?_, e.left_inv ((hsrc y).mpr h1)⟩
      have := e.left_inv ((hsrc y).mpr h1)
      rw [h0, ← hneg, e.left_inv ((hsrc _).mpr (north_ne_neg n).symm)] at this
      exact this.symm
  -- A continuous image of a path-connected set is path-connected (Analysis I), and
  -- `ℝⁿ ∖ {0}` is path-connected because `ℝⁿ` has dimension `n > 1`.
  rw [← himage]
  refine (isPathConnected_compl_singleton_of_one_lt_rank ?_ 0).image hcont
  rw [← Module.finrank_eq_rank, finrank_euclideanSpace_fin]; exact_mod_cast hn

end Sphere

/-! ## `Sⁿ` is simply connected (`thm:spheres-sc`, `thm:sk-sn` for `k = 1`) -/

/-- **`thm:spheres-sc`**: `Sⁿ` is simply connected for `n ≥ 2`. Mathlib: none in v4.34.1.

The book's proof: `U = Sⁿ ∖ {N}` and `V = Sⁿ ∖ {S}` are homeomorphic to `ℝⁿ`
(`prop:stereographic`), hence simply connected, and `U ∩ V` is path-connected; by
`thm:generation`, `π₁(Sⁿ)` is generated by two trivial groups. -/
theorem spheres_simplyConnected (n : ℕ) (hn : 2 ≤ n) : SimplyConnected (Sphere n) := by
  -- Step 1. `Sⁿ = U ∪ V`: a point that is `N` is not `S`.
  have hUV : ∀ y : Sphere n, y ∈ ({Sphere.north n}ᶜ : Set (Sphere n)) ∨
      y ∈ ({-Sphere.north n}ᶜ : Set (Sphere n)) := fun y => by
    by_cases h : y = Sphere.north n
    · right; rw [h]; exact Sphere.north_ne_neg n
    · left; exact h
  -- Step 2. `U ≅ ℝⁿ` and `V ≅ ℝⁿ` are contractible, so simply connected
  -- (`cor:contractible-sc`); `U ∩ V` is path-connected; take `x ∈ U ∩ V`.
  have hU := (stereo n (Sphere.north n)).contractible (contractible_Rn n)
  have hV := (stereo n (-Sphere.north n)).contractible (contractible_Rn n)
  have hUVc := Sphere.pathConnected_inter n hn
  obtain ⟨⟨x, hxU, hxV⟩⟩ := hUVc.1
  have hgen := generation (Sphere.isOpen_compl n _) (Sphere.isOpen_compl n _) hUV hUVc hxU hxV
  -- By `def:simply-connected` (with `thm:change-basepoint`) it suffices: `Sⁿ` is
  -- path-connected, and `π₁(Sⁿ, x) = 1`.
  rw [simplyConnected_iff_exists]
  refine ⟨⟨⟨x⟩, fun y z => ?_⟩, x, fun a => ?_⟩
  · -- Step 3. Path-connected: each point `y` lies in `U` or in `V`, and is joined to `x` inside
    -- it; then `y` is joined to `z` through `x`.
    have toX : ∀ y : Sphere n, Nonempty (Path y x) := fun y => by
      rcases hUV y with hy | hy
      · obtain ⟨p⟩ := hU.simplyConnected.1.2 ⟨y, hy⟩ ⟨x, hxU⟩
        exact ⟨p.map continuous_subtype_val rfl rfl⟩
      · obtain ⟨p⟩ := hV.simplyConnected.1.2 ⟨y, hy⟩ ⟨x, hxV⟩
        exact ⟨p.map continuous_subtype_val rfl rfl⟩
    obtain ⟨p⟩ := toX y
    obtain ⟨q⟩ := toX z
    exact ⟨p.trans q.symm⟩
  · -- Step 4. `π₁(Sⁿ, x)` is generated by the images of `π₁(U, x) = 1` and `π₁(V, x) = 1`,
    -- which are `{1}`; so it is the trivial group `⊥`.
    have ha : a ∈ (⊤ : Subgroup (pi1 x)) := Subgroup.mem_top a
    rw [← hgen] at ha
    refine Subgroup.mem_bot.mp ((Subgroup.closure_le _).mpr ?_ ha)
    intro y hy
    rcases hy with ⟨b, rfl⟩ | ⟨b, rfl⟩
    · rw [hU.simplyConnected.2 _ b, map_one]; exact Subgroup.one_mem _
    · rw [hV.simplyConnected.2 _ b, map_one]; exact Subgroup.one_mem _

/-- **`thm:sk-sn`** for `k = 1` only: every loop `f` in `Sⁿ`, `n ≥ 2`, is null-homotopic rel the
base point, `f ≃ₚ c_x`; this is `thm:spheres-sc`. The general case `[Sᵏ, Sⁿ] = ∗` for `k < n`
needs simplicial approximation and is not here. Mathlib: none.

Lean: `Quotient.exact` turns "`[f] = [c_x]`" into "`f ≃ₚ c_x`". -/
theorem loop_nullhomotopic (n : ℕ) (hn : 2 ≤ n) {x : Sphere n} (f : Path x x) :
    f.Homotopic (Path.refl x) :=
  Quotient.exact ((spheres_simplyConnected n hn).2 x ⟦f⟧)

/-! ## `S²` is neither `S¹` nor `T²` (`cor:s2-not-s1-t2`) -/

/-- **`cor:s2-not-s1-t2`**: `S²` is not homeomorphic to `S¹`. A homeomorphism `S¹ ≅ S²` would be a
homotopy equivalence (`def:homotopy-equivalence`), giving `ℤ ≅ π₁(S¹) ≅ π₁(S²) = 1`
(`thm:pi1-homotopy-invariant`, `thm:pi1-circle`, `thm:spheres-sc`). For every `n ≥ 2`:
`sphere_not_homeomorph_S1`. Mathlib: none. -/
theorem sphere2_not_homeomorph_S1 : ¬ Nonempty (Homeomorph (Sphere 2) S1) := fun ⟨h⟩ =>
  S1_not_homotopyEquivalent_of_pi1_trivial (spheres_simplyConnected 2 le_rfl).2
    h.inv.homotopyEquivalent

/-- **`cor:s2-not-s1-t2`**: `S²` is not homeomorphic to the torus `T² = S¹ × S¹`: a homeomorphism
would give `ℤ² ≅ π₁(T²) ≅ π₁(S²) = 1` (`thm:pi1-homotopy-invariant`, `cor:circle-consequences`,
`thm:spheres-sc`). Mathlib: none. -/
theorem sphere2_not_homeomorph_torus : ¬ Nonempty (Homeomorph (Sphere 2) (S1 × S1)) := by
  -- `h⁻¹ : T² → S²` induces an isomorphism `e : π₁(T², (1, 1)) ≅ π₁(S², h⁻¹(1, 1))`. The element
  -- of `π₁(T²)` that `π₁(T²) ≅ ℤ²` sends to `(1, 0)` goes to `1` in `π₁(S²) = 1`, so it is `1`,
  -- and `(1, 0) = (0, 0)` in `ℤ²`.
  rintro ⟨h⟩
  let e := pi1EquivOfIsHomotopyEquiv h.inv.isHomotopyEquiv ((1 : S1), (1 : S1))
  have h1 := (spheres_simplyConnected 2 le_rfl).2 _
    (e (pi1Torus.symm (Multiplicative.ofAdd 1, 1)))
  rw [← map_one e] at h1
  have h2 := congrArg pi1Torus (e.injective h1)
  rw [MulEquiv.apply_symm_apply, MulEquiv.map_one pi1Torus] at h2
  have := congrArg (fun q => Multiplicative.toAdd q.1) h2
  simp at this

/-! ## `Sⁿ`, `S¹` and the tori `Tᵐ` (`cor:s2-not-s1-t2`)

The torus `Tᵐ = S¹ × ⋯ × S¹` (`m` factors) is built one factor at a time: `T⁰` is a point and
`Tᵐ⁺¹ = S¹ × Tᵐ`, with the product topology (`thm:product-top`) at each step. Then
`π₁(Tᵐ) ≅ ℤᵐ` follows from `prop:pi1-product` and `thm:pi1-circle` by induction on `m`. -/

/-- The torus `Tᵐ = S¹ × ⋯ × S¹`, `m` factors: `T⁰` is a point, `Tᵐ⁺¹ = S¹ × Tᵐ`. So `T¹` is
`S¹ × T⁰`, a circle times a point, and `T²` is `S¹ × (S¹ × T⁰)`. Mathlib: `Fin m → Circle`.

Lean: a definition "by recursion": the line `| 0 => …` says what `T⁰` is, the line
`| m + 1 => …` what `Tᵐ⁺¹` is, in terms of `Tᵐ`. `Unit` is the set with one point `()`. -/
def Torus : ℕ → Type
  | 0 => Unit
  | m + 1 => S1 × Torus m

/-- The topology of `Tᵐ`: on the point `T⁰` every set is open; on `Tᵐ⁺¹ = S¹ × Tᵐ` it is the
product topology (`thm:product-top`) of `S¹` and `Tᵐ`. Mathlib: `Pi.topologicalSpace`.

Lean: `@prod S1 (Torus m) _ (torusTop m)` is the product topology, with the topology of `Tᵐ`
named explicitly (the `@` lets us pass it by hand). -/
instance torusTop : (m : ℕ) → TopSpace (Torus m)
  | 0 => { IsOpen := fun _ => True, isOpen_univ := trivial, isOpen_inter := fun _ _ _ _ => trivial,
            isOpen_sUnion := fun _ _ => trivial }
  | m + 1 => @prod S1 (Torus m) _ (torusTop m)

/-- The point `(1, …, 1)` of `Tᵐ`. -/
def Torus.one : (m : ℕ) → Torus m
  | 0 => ()
  | m + 1 => ((1 : S1), Torus.one m)

/-- The fundamental group of a point is trivial: every loop in `T⁰` is the constant loop, as
there is only one point to be at. -/
theorem pi1_point_eq_one (x : Torus 0) (a : pi1 x) : a = 1 := by
  -- Write `a = [f]`; then `f(s) = x = c_x(s)` for every `s`, so `f = c_x`.
  induction a using Quotient.ind
  exact congrArg _ (Path.ext fun _ => Subsingleton.elim (α := Unit) _ _)

/-- `ℤ × ℤᵐ ≅ ℤᵐ⁺¹`: `(k, (k₁, …, kₘ)) ↦ (k, k₁, …, kₘ)`, an isomorphism of groups (written
multiplicatively). Mathlib: `Fin.consEquiv`.

Lean: `ℤᵐ` is `Fin m → ℤ`, the `m`-tuples `(k₀, …, kₘ₋₁)` of integers, numbered from `0`
(`Fin m = {0, …, m - 1}`); `Fin.cons k t` puts `k` in front of the tuple `t`, and `Fin.tail`
removes the first entry. -/
def zConsEquiv (m : ℕ) :
    Multiplicative ℤ × Multiplicative (Fin m → ℤ) ≃* Multiplicative (Fin (m + 1) → ℤ) where
  toFun p := Multiplicative.ofAdd (Fin.cons (Multiplicative.toAdd p.1) (Multiplicative.toAdd p.2))
  invFun f := (Multiplicative.ofAdd (Multiplicative.toAdd f 0),
    Multiplicative.ofAdd (Fin.tail (Multiplicative.toAdd f)))
  -- Putting the first entry in front and removing it are inverse.
  left_inv p := by simp
  right_inv f := by simp
  -- Sums are taken entry by entry: check the entry `0` and the entries `j + 1`.
  map_mul' p q := by
    change Multiplicative.ofAdd _ = Multiplicative.ofAdd (_ + _)
    congr 1
    funext i
    refine Fin.cases ?_ (fun j => ?_) i <;> simp

/-- **`cor:circle-consequences`**: `π₁(Tᵐ, x) ≅ ℤᵐ`, at every point `x` of `Tᵐ`.
Mathlib: none (`FundamentalGroup.piEquiv` gives the product formula).

The proof, by induction on `m`: `π₁(T⁰) = 1 = ℤ⁰` (`pi1_point_eq_one`); and for
`x = (z, y) ∈ S¹ × Tᵐ`, `π₁(Tᵐ⁺¹, x) ≅ π₁(S¹, z) × π₁(Tᵐ, y)` (`prop:pi1-product`)
`≅ ℤ × ℤᵐ` (`thm:pi1-circle` at `z`, and the induction hypothesis) `≅ ℤᵐ⁺¹`. -/
def pi1TorusN : (m : ℕ) → (x : Torus m) → pi1 x ≃* Multiplicative (Fin m → ℤ)
  -- `m = 0`: both groups have one element.
  | 0, x =>
    { toFun := fun _ => 1
      invFun := fun _ => 1
      left_inv := fun a => (pi1_point_eq_one x a).symm
      right_inv := fun _ => funext fun i => i.elim0
      map_mul' := fun _ _ => (mul_one 1).symm }
  -- `m + 1`: `π₁(S¹ × Tᵐ, (z, y)) ≅ π₁(S¹, z) × π₁(Tᵐ, y) ≅ ℤ × ℤᵐ ≅ ℤᵐ⁺¹`.
  | m + 1, x =>
    (pi1Prod (X := S1) (Y := Torus m) x.1 x.2).trans
      ((MulEquiv.prodCongr (pi1CircleAt x.1) (pi1TorusN m x.2)).trans (zConsEquiv m))

/-- **`cor:s2-not-s1-t2`**: `Sⁿ` is not homeomorphic to `S¹` for `n ≥ 2`: a homeomorphism
`S¹ ≅ Sⁿ` would be a homotopy equivalence, giving `ℤ ≅ π₁(S¹) ≅ π₁(Sⁿ) = 1`
(`thm:pi1-homotopy-invariant`, `thm:pi1-circle`, `thm:spheres-sc`). Mathlib: none. -/
theorem sphere_not_homeomorph_S1 (n : ℕ) (hn : 2 ≤ n) :
    ¬ Nonempty (Homeomorph (Sphere n) S1) := fun ⟨h⟩ =>
  S1_not_homotopyEquivalent_of_pi1_trivial (spheres_simplyConnected n hn).2
    h.inv.homotopyEquivalent

/-- **`cor:s2-not-s1-t2`**: `Sⁿ` is not homeomorphic to the torus `Tᵐ`, for `n ≥ 2` and
`m ≥ 1`: a homeomorphism `h` would give `ℤᵐ ≅ π₁(Tᵐ) ≅ π₁(Sⁿ) = 1`
(`thm:pi1-homotopy-invariant`, `cor:circle-consequences`, `thm:spheres-sc`), while `ℤᵐ ≠ 0` as
`m ≥ 1`. Mathlib: none. -/
theorem sphere_not_homeomorph_Torus (n : ℕ) (hn : 2 ≤ n) (m : ℕ) (hm : 1 ≤ m) :
    ¬ Nonempty (Homeomorph (Sphere n) (Torus m)) := by
  rintro ⟨h⟩
  -- Step 1. Take `x = h(N) ∈ Tᵐ`; `h⁻¹` induces `e : π₁(Tᵐ, x) ≅ π₁(Sⁿ, h⁻¹(x))`.
  let x := h.toEquiv (Sphere.north n)
  let e := pi1EquivOfIsHomotopyEquiv h.inv.isHomotopyEquiv x
  -- Step 2. Let `a ∈ π₁(Tᵐ, x)` correspond to `(1, 0, …, 0) ∈ ℤᵐ` (`Pi.single i 1` is the tuple
  -- with `1` at place `i` and `0` elsewhere). Then `e(a) = 1`, as `π₁(Sⁿ) = 1`; so `a = 1`.
  let a := (pi1TorusN m x).symm (Multiplicative.ofAdd (Pi.single ⟨0, hm⟩ 1))
  have h1 : e a = 1 := (spheres_simplyConnected n hn).2 _ _
  rw [← map_one e] at h1
  -- Step 3. Hence `(1, 0, …, 0) = (0, …, 0)` in `ℤᵐ`; the first entries say `1 = 0`.
  have h2 := congrArg (pi1TorusN m x) (e.injective h1)
  rw [MulEquiv.apply_symm_apply, map_one] at h2
  have h3 := congrFun (congrArg Multiplicative.toAdd h2) ⟨0, hm⟩
  simp at h3

/-- **`cor:s2-not-s1-t2`**: `Tᵐ ≅ Tᵐ'` only if `m = m'`: a homeomorphism gives
`ℤᵐ ≅ π₁(Tᵐ) ≅ π₁(Tᵐ') ≅ ℤᵐ'` (`thm:pi1-homotopy-invariant`, `cor:circle-consequences`), and
`ℤᵐ ≅ ℤᵐ'` forces `m = m'`. Mathlib: none.

The book counts `ℤᵐ/2ℤᵐ`, which has `2ᵐ` elements; here the last step is Mathlib's rank of a
free abelian group instead (`AddEquiv.toIntLinearEquiv`, `LinearEquiv.finrank_eq`,
`Module.finrank_fin_fun`: an isomorphism `ℤᵐ ≅ ℤᵐ'` is `ℤ`-linear, and `ℤᵐ` has rank `m`). -/
theorem eq_of_Torus_homeomorph {m m' : ℕ} (h : Nonempty (Homeomorph (Torus m) (Torus m'))) :
    m = m' := by
  obtain ⟨h⟩ := h
  -- Step 1. `h` induces `e : π₁(Tᵐ, 1) ≅ π₁(Tᵐ', h(1))`, so `E : ℤᵐ ≅ ℤᵐ'`.
  let e := pi1EquivOfIsHomotopyEquiv h.isHomotopyEquiv (Torus.one m)
  let E := (pi1TorusN m _).symm.trans (e.trans (pi1TorusN m' _))
  -- Step 2. Read `E` additively; it preserves the rank, `m = rank ℤᵐ = rank ℤᵐ' = m'`.
  simpa using (AddEquiv.toMultiplicative.symm E).toIntLinearEquiv.finrank_eq

/-- **`cor:s2-not-s1-t2`**: `S¹` is not homeomorphic to `Tᵐ` for `m ≥ 2` (the book: "as
`T¹ = S¹`"): a homeomorphism gives `ℤ ≅ π₁(S¹) ≅ π₁(Tᵐ) ≅ ℤᵐ`, and the ranks `1` and `m`
differ. The rank is Mathlib's, as in `eq_of_Torus_homeomorph` (also `Module.finrank_self`).
Mathlib: none. -/
theorem S1_not_homeomorph_Torus (m : ℕ) (hm : 2 ≤ m) :
    ¬ Nonempty (Homeomorph S1 (Torus m)) := by
  rintro ⟨h⟩
  -- `ℤ ≅ π₁(S¹, 1) ≅ π₁(Tᵐ, h(1)) ≅ ℤᵐ`, so `1 = rank ℤ = rank ℤᵐ = m ≥ 2`.
  let e := pi1EquivOfIsHomotopyEquiv h.isHomotopyEquiv (1 : S1)
  let E := pi1Circle.symm.trans (e.trans (pi1TorusN m _))
  have := (AddEquiv.toMultiplicative.symm E).toIntLinearEquiv.finrank_eq
  simp at this
  omega

/-! ## `ℝ² ≇ ℝⁿ` for `n ≠ 2` (`cor:R2-R3`) -/

/-- A homeomorphism `h : X ≅ Y` that carries `A ⊆ X` onto `B ⊆ Y` (`hAB`: `h(a) ∈ B` iff
`a ∈ A`) restricts to a homeomorphism `A ≅ B`, continuous both ways into the subspaces
(`prop-1-15`). Mathlib: `Homeomorph.subtype`. -/
def Homeomorph.restrict [TopSpace X] [TopSpace Y] (h : Homeomorph X Y) (A : Set X) (B : Set Y)
    (hAB : ∀ a, h.toEquiv a ∈ B ↔ a ∈ A) : Homeomorph A B where
  toFun a := ⟨h.toEquiv a, (hAB a).mpr a.2⟩
  invFun b := ⟨h.toEquiv.symm b, (hAB _).mp (by rw [h.toEquiv.apply_symm_apply]; exact b.2)⟩
  left_inv a := Subtype.ext (h.toEquiv.symm_apply_apply a)
  right_inv b := Subtype.ext (h.toEquiv.apply_symm_apply b)
  continuous_toFun := continuous_into_subspace (h.continuous_toFun.comp continuous_subtype_val) _
  continuous_invFun :=
    continuous_into_subspace (h.continuous_invFun.comp continuous_subtype_val) _

/-- `ℝᵐ⁺¹ ∖ {p}` is homotopy equivalent to `Sᵐ` (`fig-6-punctured-plane`, centred at `p`): by
`φ(u) = p + u` and `ψ(y) = (y - p)/|y - p|`, with `ψ φ = id` and the straight-line homotopy
`H(y, t) = (1 - t) φψ(y) + t y = p + ((1 - t)/|y - p| + t)(y - p)` from `φψ` to the identity,
which never reaches `p`. `def:homotopy-equivalence`. Mathlib: none as such. -/
theorem punctured_homotopyEquivalent (m : ℕ) (p : Rn (m + 1)) :
    HomotopyEquivalent (Sphere m) ({p}ᶜ : Set (Rn (m + 1))) := by
  have hu0 : ∀ u : Sphere m, (u : Rn (m + 1)) ≠ 0 := fun u => ne_zero_of_mem_unit_sphere u
  have hyp : ∀ y : ({p}ᶜ : Set (Rn (m + 1))), ‖(y : Rn (m + 1)) - p‖ ≠ 0 := fun y =>
    norm_ne_zero_iff.mpr (sub_ne_zero.mpr y.2)
  -- The two maps; `p + u ≠ p` as `u ≠ 0`, and `|(y - p)/|y - p|| = 1`.
  let φ : Sphere m → ({p}ᶜ : Set (Rn (m + 1))) := fun u =>
    ⟨p + u, fun h => hu0 u (by simpa using h)⟩
  let ψ : ({p}ᶜ : Set (Rn (m + 1))) → Sphere m := fun y =>
    ⟨‖(y : Rn (m + 1)) - p‖⁻¹ • ((y : Rn (m + 1)) - p), by
      rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (hyp y)]⟩
  -- Both are continuous (Analysis I, through the bridges; `1/|y - p|` as `|y - p| ≠ 0`).
  have hφ : Continuous φ := continuous_into_subspace (continuous_of_mathlib_eq
    (sphere_toMathlib m) (euclid_toMathlib _)
    (_root_.continuous_const.add _root_.continuous_subtype_val)) _
  have hψ : Continuous ψ := continuous_into_subspace (continuous_of_mathlib_eq
    (compl_toMathlib _ p) (euclid_toMathlib _)
    ((((_root_.continuous_subtype_val.sub _root_.continuous_const).norm).inv₀ hyp).smul
      (_root_.continuous_subtype_val.sub _root_.continuous_const))) _
  refine ⟨φ, hφ, ψ, hψ, ?_, ?_⟩
  · -- `ψ(φ(u)) = u/|u| = u`, since `|u| = 1`; and `id ≃ id`.
    have : ψ ∘ φ = fun u => u := by
      funext u
      apply Subtype.ext
      show ‖p + (u : Rn (m + 1)) - p‖⁻¹ • (p + (u : Rn (m + 1)) - p) = u
      simp [norm_eq_of_mem_sphere u]
    rw [this]; exact Homotopic.refl continuous_id
  · -- `c(y, t) = (1 - t)/|y - p| + t > 0`: for `t < 1` the first term is `> 0`, for `t = 1`
    -- it is `1`.
    have hc : ∀ (y : ({p}ᶜ : Set (Rn (m + 1)))) (t : I),
        0 < (1 - (t : ℝ)) * ‖(y : Rn (m + 1)) - p‖⁻¹ + t := fun y t => by
      have hn : 0 < ‖(y : Rn (m + 1)) - p‖⁻¹ :=
        inv_pos.mpr (norm_pos_iff.mpr (sub_ne_zero.mpr y.2))
      rcases lt_or_eq_of_le t.2.2 with h | h
      · have : 0 < (1 - (t : ℝ)) * ‖(y : Rn (m + 1)) - p‖⁻¹ := mul_pos (by linarith) hn
        linarith [t.2.1]
      · rw [h]; norm_num
    -- So `H(y, t) = p + c(y, t)(y - p) ≠ p`: else `c(y, t)(y - p) = 0` with `c ≠ 0`, `y ≠ p`.
    have hne : ∀ q : ({p}ᶜ : Set (Rn (m + 1))) × I,
        p + ((1 - (q.2 : ℝ)) * ‖(q.1 : Rn (m + 1)) - p‖⁻¹ + q.2) • ((q.1 : Rn (m + 1)) - p) ≠
          p := fun q h => by
      have h' : ((1 - (q.2 : ℝ)) * ‖(q.1 : Rn (m + 1)) - p‖⁻¹ + q.2) •
          ((q.1 : Rn (m + 1)) - p) = 0 := by simpa using h
      rcases smul_eq_zero.mp h' with h0 | h0
      · exact (hc q.1 q.2).ne' h0
      · exact q.1.2 (sub_eq_zero.mp h0)
    have hX : (prod : TopSpace (({p}ᶜ : Set (Rn (m + 1))) × I)).toMathlib =
        (inferInstance : TopologicalSpace (({p}ᶜ : Set (Rn (m + 1))) × I)) := by
      rw [prod_toMathlib, compl_toMathlib, I_toMathlib]
    -- The homotopy `H`: continuous by Analysis I (through `hX`); `H(y, 0) = p + (y - p)/|y - p|
    -- = φ(ψ(y))` and `H(y, 1) = p + (y - p) = y`.
    refine ⟨{ toFun := fun q => ⟨_, hne q⟩
              continuous_toFun := continuous_into_subspace (continuous_of_mathlib_eq hX
                (euclid_toMathlib _) ?_) _
              zero' := fun y => ?_
              one' := fun y => ?_ }⟩
    · exact _root_.continuous_const.add ((((_root_.continuous_const.sub
        (_root_.continuous_subtype_val.comp _root_.continuous_snd)).mul
        (((_root_.continuous_subtype_val.comp _root_.continuous_fst).sub
          _root_.continuous_const).norm.inv₀ (fun q => hyp q.1))).add
        (_root_.continuous_subtype_val.comp _root_.continuous_snd)).smul
        ((_root_.continuous_subtype_val.comp _root_.continuous_fst).sub _root_.continuous_const))
    · apply Subtype.ext
      show p + ((1 - ((0 : I) : ℝ)) * ‖(y : Rn (m + 1)) - p‖⁻¹ + ((0 : I) : ℝ)) •
        ((y : Rn (m + 1)) - p) = p + ‖(y : Rn (m + 1)) - p‖⁻¹ • ((y : Rn (m + 1)) - p)
      simp
    · apply Subtype.ext
      show p + ((1 - ((1 : I) : ℝ)) * ‖(y : Rn (m + 1)) - p‖⁻¹ + ((1 : I) : ℝ)) •
        ((y : Rn (m + 1)) - p) = y
      simp

/-- **`cor:R2-R3`**: `ℝ² ≇ ℝⁿ` for `n ≥ 3`. Mathlib: none (invariance of dimension is not in
v4.34.1).

The book's proof: a homeomorphism `h : ℝ² → ℝⁿ` restricts to `ℝ² ∖ {0} ≅ ℝⁿ ∖ {h(0)}`; these are
homotopy equivalent to `S¹` (`cor:circle-consequences`) and to `Sⁿ⁻¹`
(`punctured_homotopyEquivalent`); but `π₁(S¹) ≅ ℤ` (`thm:pi1-circle`) and `Sⁿ⁻¹` is simply
connected (`thm:spheres-sc`, as `n - 1 ≥ 2`), against `thm:pi1-homotopy-invariant`. -/
theorem R2_not_homeomorph_Rn (n : ℕ) (hn : 3 ≤ n) :
    ¬ Nonempty (Homeomorph (ℝ × ℝ) (Rn n)) := by
  rintro ⟨h⟩
  -- Write `n = m + 1`, `m ≥ 2`. (Lean: `obtain ⟨m, rfl⟩` replaces `n` by `m + 1` everywhere.)
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  -- `ℝ² ∖ {0} ≅ ℝⁿ ∖ {h(0)}`: `h(a) ≠ h(0)` iff `a ≠ 0`, as `h` is one to one.
  have h2 : HomotopyEquivalent Plane0 ({h.toEquiv 0}ᶜ : Set (Rn (m + 1))) :=
    (h.restrict Plane0 _ (fun a => h.toEquiv.injective.ne_iff)).homotopyEquivalent
  -- So `S¹ ≃ ℝ² ∖ {0} ≃ ℝⁿ ∖ {h(0)} ≃ Sᵐ`, and `Sᵐ` has trivial `π₁`: absurd
  -- (`S1_not_homotopyEquivalent_of_pi1_trivial`).
  exact S1_not_homotopyEquivalent_of_pi1_trivial (spheres_simplyConnected m (by omega)).2
    ((Plane0.homotopyEquivalent_S1.trans h2).trans
      (punctured_homotopyEquivalent m (h.toEquiv 0)).symm)

/-- **`cor:R2-R3`** for `n = 0`: `ℝ² ≇ ℝ⁰`, as `ℝ⁰` is a point and `ℝ²` is not: a bijection
`h` would send `(0, 0) ≠ (1, 0)` to the same point. Mathlib: none.

Lean: `Subsingleton.elim` says that any two points of `ℝ⁰` are equal. -/
theorem R2_not_homeomorph_R0 : ¬ Nonempty (Homeomorph (ℝ × ℝ) (Rn 0)) := by
  rintro ⟨h⟩
  have := h.toEquiv.injective (Subsingleton.elim (h.toEquiv (0, 0)) (h.toEquiv (1, 0)))
  simp at this

/-- The course's `ℝ` and `ℝ¹` are homeomorphic, by `t ↦ (t)`, the `1`-tuple. Mathlib:
`Homeomorph.funUnique` and `EuclideanSpace.equiv`, through the bridges `real_toMathlib`,
`euclid_toMathlib`. -/
def realHomeomorphR1 : Homeomorph ℝ (Rn 1) :=
  homeomorphOfMathlib real_toMathlib (euclid_toMathlib 1)
    ((Homeomorph.funUnique (Fin 1) ℝ).symm.trans
      (EuclideanSpace.equiv (Fin 1) ℝ).toHomeomorph.symm)

/-- **`cor:R2-R3`** for `n = 1`: `ℝ² ≇ ℝ¹`. This is `prop:line-not-plane`
(`real_not_homeomorph_plane`), carried along `ℝ ≅ ℝ¹`: from `h : ℝ² ≅ ℝ¹` we would get
`h⁻¹ ∘ (ℝ ≅ ℝ¹) : ℝ ≅ ℝ²`. Mathlib: none. -/
theorem R2_not_homeomorph_R1 : ¬ Nonempty (Homeomorph (ℝ × ℝ) (Rn 1)) := by
  rintro ⟨h⟩
  -- The composite `ℝ → ℝ¹ → ℝ²` and its inverse are continuous as composites.
  exact real_not_homeomorph_plane ⟨
    { toEquiv := realHomeomorphR1.toEquiv.trans h.toEquiv.symm
      continuous_toFun := h.continuous_invFun.comp realHomeomorphR1.continuous_toFun
      continuous_invFun := realHomeomorphR1.continuous_invFun.comp h.continuous_toFun }⟩

/-- **`cor:R2-R3`**: `ℝ² ≇ ℝⁿ` for every `n ≠ 2`. Mathlib: none (invariance of dimension is not
in v4.34.1).

The book's proof: `ℝ⁰` is a point (`R2_not_homeomorph_R0`), `n = 1` is `prop:line-not-plane`
(`R2_not_homeomorph_R1`), and `n ≥ 3` is `R2_not_homeomorph_Rn`. -/
theorem R2_not_homeomorph_Rn_of_ne (n : ℕ) (hn : n ≠ 2) :
    ¬ Nonempty (Homeomorph (ℝ × ℝ) (Rn n)) := by
  -- The cases `n = 0`, `1`, `2`, and `n + 3 ≥ 3`.
  obtain _ | _ | _ | n := n
  · exact R2_not_homeomorph_R0
  · exact R2_not_homeomorph_R1
  · exact absurd rfl hn
  · exact R2_not_homeomorph_Rn (n + 3) (by omega)

/-! ## A map that misses a point (`prop:nonsurjective-nullhomotopic`) -/

/-- **`prop:nonsurjective-nullhomotopic`**: a continuous `f : Sᵏ → Sⁿ` that misses a point `q`
(`hq`) is null-homotopic: `f ≃ c` for a constant map `c`. (Not rel the base point.) Mathlib:
`ContinuousMap.Nullhomotopic` (the notion; the statement is not in v4.34.1).

The book's proof: `f` lands in `Sⁿ ∖ {q} ≅ ℝⁿ` (`prop:stereographic`), which is contractible as
`ℝⁿ` is convex; follow a contraction `H` of `Sⁿ ∖ {q}`: `(x, t) ↦ H(f(x), t)`. -/
theorem nullhomotopic_of_not_surjective {k n : ℕ} {f : Sphere k → Sphere n} (hf : Continuous f)
    {q : Sphere n} (hq : ∀ x, f x ≠ q) : ∃ c : Sphere n, Homotopic f (fun _ => c) := by
  -- `Sⁿ ∖ {q}` is contractible (`stereo`, `contractible_Rn`): `H : id ≃ c`.
  obtain ⟨c, ⟨H⟩⟩ := (stereo n q).contractible (contractible_Rn n)
  -- The homotopy `(x, t) ↦ H(f(x), t)`, continuous as a composite; at `t = 0` it is `f(x)`, at
  -- `t = 1` it is `c`.
  refine ⟨c.1, ⟨{ toFun := fun z => (H.toFun (⟨f z.1, hq z.1⟩, z.2)).1
                  continuous_toFun := continuous_subtype_val.comp (H.continuous_toFun.comp
                    ((continuous_into_subspace (hf.comp continuous_fst) _).prodMk
                      continuous_snd))
                  zero' := fun x => ?_
                  one' := fun x => ?_ }⟩⟩
  · show (H.toFun (⟨f x, hq x⟩, 0)).1 = f x
    rw [H.zero']
  · show (H.toFun (⟨f x, hq x⟩, 1)).1 = c.1
    rw [H.one']

/-! ## `[Sᵏ, Sⁿ] = *` for `k < n` (`thm:sk-sn`), by the smooth route (`rem:which-route`)

The book proves `thm:sk-sn` by simplicial approximation; `rem:which-route` sketches a smooth
route, which is the one followed here, without base points. Given `f : Sᵏ → Sⁿ`:
1. *Approximation.* By Stone–Weierstrass there is a differentiable `P : ℝᵏ⁺¹ → ℝⁿ⁺¹` with
   `|P(x) - f(x)| < 1` on `Sᵏ` (`exists_differentiable_near`).
2. *Homotopy.* `g = P/|P|` never takes the value antipodal to `f`, so `f ≃ g`
   (`exr-6-antipodal`, `homotopic_of_ne_neg`).
3. *Measure zero.* The cone `{s g(u) : s > 0, u ∈ Sᵏ}` is the image of the `(k + 1)`-dimensional
   set `ℝᵏ⁺¹ ∖ {0}` under a differentiable map, so it is too small to be all of `ℝⁿ⁺¹ ∖ {0}`
   when `k + 1 < n + 1` (the easy case of Sard); so `g` is not onto (`exists_not_mem_normalize`).
4. `g` is null-homotopic (`prop:nonsurjective-nullhomotopic`), hence so is `f`
   (`sk_sn_nullhomotopic`). -/

/-- The functions on `Sᵏ` that are restrictions of differentiable functions `h : ℝᵏ⁺¹ → ℝ`. They
form a subalgebra of the continuous functions `C(Sᵏ, ℝ)`: sums, products and constants of
differentiable functions are differentiable (Analysis I). Used for `rem:which-route`, step 1.
(Polynomials would do as well; differentiable functions are all that step 3 needs.) Mathlib:
`Subalgebra`.

Lean: `C(Sphere k, ℝ)` is the type of continuous maps `Sᵏ → ℝ` (Mathlib's topologies); a
`Subalgebra` is given by its set (`carrier`) and the proofs that it is closed under `*`, `+` and
contains the constants (`algebraMap r` is the constant function `r`). -/
def diffRestrictions (k : ℕ) : Subalgebra ℝ C(Sphere k, ℝ) where
  carrier := {g | ∃ h : Rn (k + 1) → ℝ, Differentiable ℝ h ∧ ∀ x, g x = h x}
  -- If `a = h|`, `b = h'|`, then `ab = (h h')|` and `a + b = (h + h')|`; the constant `r` is `r|`.
  mul_mem' := by
    rintro a b ⟨h, hh, ha⟩ ⟨h', hh', hb⟩
    exact ⟨fun x => h x * h' x, hh.mul hh', fun x => by simp [ha, hb]⟩
  add_mem' := by
    rintro a b ⟨h, hh, ha⟩ ⟨h', hh', hb⟩
    exact ⟨fun x => h x + h' x, hh.add hh', fun x => by simp [ha, hb]⟩
  algebraMap_mem' r := ⟨fun _ => r, differentiable_const r, fun x => by simp⟩

/-- The subalgebra `diffRestrictions k` separates the points of `Sᵏ`: if `x ≠ y`, some
coordinate `vᵢ`, a linear (hence differentiable) function of `v`, takes different values at
`x` and `y`. The hypothesis of Stone–Weierstrass in `rem:which-route`, step 1. Mathlib:
`Subalgebra.SeparatesPoints`. -/
theorem diffRestrictions_separatesPoints (k : ℕ) : (diffRestrictions k).SeparatesPoints := by
  intro x y hxy
  -- Two vectors with the same coordinates are equal, so some coordinate `i` differs.
  obtain ⟨i, hi⟩ : ∃ i, (x : Rn (k + 1)) i ≠ (y : Rn (k + 1)) i := by
    by_contra h
    push Not at h
    exact hxy (Subtype.ext (by ext i; exact h i))
  -- The coordinate function `v ↦ vᵢ`, restricted to `Sᵏ`, is in the subalgebra.
  refine ⟨fun z => (z : Rn (k + 1)) i, ⟨⟨fun z => (z : Rn (k + 1)) i, by fun_prop⟩,
    ⟨fun v => v i, by fun_prop, fun z => rfl⟩, rfl⟩, hi⟩

/-- **`rem:which-route`, step 1 (approximation).** For a continuous `f : Sᵏ → Sⁿ` (Mathlib's
sense, `hf`) there is a differentiable `P : ℝᵏ⁺¹ → ℝⁿ⁺¹` with `|P(x) - f(x)| < 1` for every
`x ∈ Sᵏ`. Mathlib, through the bridges: the Stone–Weierstrass theorem
`ContinuousMap.exists_mem_subalgebra_near_continuous_of_separatesPoints`, applied to
`diffRestrictions k`.

The proof: approximate each coordinate `fᵢ`, `i = 0, …, n`, within `1/(n + 1)` by the
restriction of a differentiable `hᵢ`, and put `P = (h₀, …, hₙ)`; then
`|P(x) - f(x)|² = Σ |hᵢ(x) - fᵢ(x)|² < (n + 1)/(n + 1)² ≤ 1`. -/
theorem exists_differentiable_near {k n : ℕ} (f : Sphere k → Sphere n)
    (hf : _root_.Continuous f) :
    ∃ P : Rn (k + 1) → Rn (n + 1), Differentiable ℝ P ∧ ∀ x : Sphere k,
      ‖P x - (f x : Rn (n + 1))‖ < 1 := by
  have hδ : (0 : ℝ) < 1 / (n + 1) := by positivity
  -- Step 1. Each coordinate `fᵢ` is within `1/(n + 1)` of some `hᵢ|`, `hᵢ` differentiable
  -- (Stone–Weierstrass, as `Sᵏ` is compact and the subalgebra separates points).
  have hcoord : ∀ i : Fin (n + 1), ∃ h : Rn (k + 1) → ℝ, Differentiable ℝ h ∧
      ∀ x : Sphere k, ‖h x - (f x : Rn (n + 1)) i‖ < 1 / (n + 1) := by
    intro i
    obtain ⟨g, hg⟩ := ContinuousMap.exists_mem_subalgebra_near_continuous_of_separatesPoints
      (diffRestrictions k) (diffRestrictions_separatesPoints k)
      (fun x => (f x : Rn (n + 1)) i) (by fun_prop) _ hδ
    obtain ⟨h, hh, hgh⟩ := g.2
    exact ⟨h, hh, fun x => by rw [← hgh]; exact hg x⟩
  -- Lean: `choose` turns "for each `i` there is `hᵢ` with …" into a family `h` with the
  -- properties `hh i`, `hnear i`.
  choose h hh hnear using hcoord
  -- Step 2. `P(v) = (h₀(v), …, hₙ(v))` is differentiable, as each coordinate is. (Lean:
  -- `WithLp.toLp 2 u` is the tuple `u` seen as a vector of `ℝⁿ⁺¹` with its euclidean norm.)
  refine ⟨fun v => WithLp.toLp 2 (fun i => h i v), ?_, fun x => ?_⟩
  · exact (differentiable_piLp _).mpr fun i => hh i
  · -- Step 3. `|P(x) - f(x)|² = Σᵢ |hᵢ(x) - fᵢ(x)|² < (n + 1) · (1/(n + 1))² ≤ 1`.
    have hsq : ‖(WithLp.toLp 2 (fun i => h i x) : Rn (n + 1)) - (f x : Rn (n + 1))‖ ^ 2 < 1 := by
      rw [EuclideanSpace.norm_sq_eq]
      calc ∑ i, ‖(WithLp.toLp 2 (fun i => h i x) - (f x : Rn (n + 1))).ofLp i‖ ^ 2
          < ∑ _i : Fin (n + 1), (1 / ((n : ℝ) + 1)) ^ 2 := by
            apply Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty
            intro i _
            simpa using pow_lt_pow_left₀ (hnear i x) (norm_nonneg _) two_ne_zero
        _ ≤ 1 := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            push_cast
            rw [div_pow, one_pow, sq, mul_one_div, div_mul_cancel_left₀ (by positivity)]
            exact inv_le_one_of_one_le₀ (by linarith [(n.cast_nonneg : (0 : ℝ) ≤ n)])
    -- A number `≥ 0` whose square is `< 1` is `< 1`.
    nlinarith [norm_nonneg ((WithLp.toLp 2 (fun i => h i x) : Rn (n + 1)) - (f x : Rn (n + 1)))]

/-- **`exr-6-antipodal`**: if `f, g : X → Sⁿ` are continuous and never antipodal,
`f(x) ≠ -g(x)` for every `x` (`hfg`), then `f ≃ g`, by
`H(x, t) = ((1 - t) f(x) + t g(x)) / |(1 - t) f(x) + t g(x)|`. `rem:which-route`, step 2.
Mathlib: none as such (`ContinuousMap.Homotopic` is the notion).

The numerator is never `0`: if `(1 - t) a + t b = 0` with `|a| = |b| = 1`, taking norms gives
`1 - t = t`, so `t = 1/2` and `a + b = 0`, that is `a = -b`, which `hfg` excludes. -/
theorem homotopic_of_ne_neg [TopSpace X] {n : ℕ} {f g : X → Sphere n} (hf : Continuous f)
    (hg : Continuous g) (hfg : ∀ x, (f x : Rn (n + 1)) ≠ -(g x : Rn (n + 1))) :
    Homotopic f g := by
  -- Step 1. The numerator `(1 - t) f(x) + t g(x)` is never `0`.
  have hne : ∀ (x : X) (t : I),
      (1 - (t : ℝ)) • (f x : Rn (n + 1)) + (t : ℝ) • (g x : Rn (n + 1)) ≠ 0 := by
    intro x t h
    -- `(1 - t) f(x) = -t g(x)`; take norms: `1 - t = t`, as `|f(x)| = |g(x)| = 1`, `t ∈ [0, 1]`.
    have h1 : (1 - (t : ℝ)) • (f x : Rn (n + 1)) = -((t : ℝ) • (g x : Rn (n + 1))) :=
      eq_neg_of_add_eq_zero_left h
    have h2 := congrArg norm h1
    rw [norm_neg, norm_smul, norm_smul, norm_eq_of_mem_sphere (f x), norm_eq_of_mem_sphere (g x),
      Real.norm_of_nonneg (by linarith [t.2.2]), Real.norm_of_nonneg t.2.1] at h2
    have ht : (t : ℝ) = 1 / 2 := by linarith
    rw [ht] at h
    -- So `f(x)/2 + g(x)/2 = 0`; times `2`, `f(x) + g(x) = 0`, that is `f(x) = -g(x)`.
    apply hfg x
    have h3 : (f x : Rn (n + 1)) + g x = 0 := by
      have := congrArg (fun v : Rn (n + 1) => (2 : ℝ) • v) h
      simp only [smul_add, smul_smul, smul_zero] at this
      norm_num at this
      exact this
    exact eq_neg_of_add_eq_zero_left h3
  -- Step 2. Continuity, by Analysis I through the bridges: `f`, `g` are continuous in Mathlib's
  -- sense for the topology `mX` of `X` (`mathlib_continuous_of_eq`), and so is the numerator `v`.
  let mX : TopologicalSpace X := (‹TopSpace X›).toMathlib
  have hfM : _root_.Continuous fun x => (f x : Rn (n + 1)) :=
    _root_.continuous_subtype_val.comp (mathlib_continuous_of_eq rfl (sphere_toMathlib n) hf)
  have hgM : _root_.Continuous fun x => (g x : Rn (n + 1)) :=
    _root_.continuous_subtype_val.comp (mathlib_continuous_of_eq rfl (sphere_toMathlib n) hg)
  have hX : (prod : TopSpace (X × I)).toMathlib =
      (inferInstance : TopologicalSpace (X × I)) := by
    rw [prod_toMathlib, I_toMathlib]
  let v : X × I → Rn (n + 1) := fun p =>
    (1 - (p.2 : ℝ)) • (f p.1 : Rn (n + 1)) + (p.2 : ℝ) • (g p.1 : Rn (n + 1))
  have hv : _root_.Continuous v :=
    ((_root_.continuous_const.sub (_root_.continuous_subtype_val.comp _root_.continuous_snd)).smul
      (hfM.comp _root_.continuous_fst)).add
      ((_root_.continuous_subtype_val.comp _root_.continuous_snd).smul
        (hgM.comp _root_.continuous_fst))
  -- `v/|v|` has norm `1`, so it lies on `Sⁿ`.
  have hmem : ∀ p, ‖v p‖⁻¹ • v p ∈ Sphere n := fun p => by
    rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr (hne p.1 p.2))]
  -- Step 3. The homotopy `H = v/|v|`, continuous as `1/|v|` is (`|v| ≠ 0`); at `t = 0` it is
  -- `f(x)/|f(x)| = f(x)`, at `t = 1` it is `g(x)/|g(x)| = g(x)`.
  refine ⟨{ toFun := fun p => ⟨‖v p‖⁻¹ • v p, hmem p⟩
            continuous_toFun := continuous_into_subspace (continuous_of_mathlib_eq hX
              (euclid_toMathlib _) ((hv.norm.inv₀ fun p => norm_ne_zero_iff.mpr
                (hne p.1 p.2)).smul hv)) _
            zero' := fun x => ?_
            one' := fun x => ?_ }⟩
  · apply Subtype.ext
    simp [v, norm_eq_of_mem_sphere (f x)]
  · apply Subtype.ext
    simp [v, norm_eq_of_mem_sphere (g x)]

/-- **`rem:which-route`, step 3 (measure zero).** Let `k < n` and `P : ℝᵏ⁺¹ → ℝⁿ⁺¹` be
differentiable and nonzero on `Sᵏ` (`h0`). Then `g = P/|P| : Sᵏ → Sⁿ` is not onto: some
`q ∈ Sⁿ` is not `g(u)` for any `u ∈ Sᵏ`. This is the easy case of Sard (`rem:which-route`).
Mathlib, through the bridges: `DifferentiableOn.dense_compl_image_of_dimH_lt_finrank` (the
image of a set of Hausdorff dimension `< n + 1` under a differentiable map has dense
complement in `ℝⁿ⁺¹`) and `Real.dimH_univ_eq_finrank` (`ℝᵏ⁺¹` has Hausdorff dimension `k + 1`).

The proof: the cone map `Φ(x) = |x| g(x/|x|)` is differentiable on `ℝᵏ⁺¹ ∖ {0}` (`x ↦ |x|` is
differentiable away from `0`), a set of dimension `k + 1 < n + 1`. If `g` were onto, every
`w ≠ 0` would be `Φ(|w| u)` with `g(u) = w/|w|`; so the complement of the image would be inside
`{0}`, which is not dense. Hausdorff dimension replaces the book's measure zero: it says the
same here (a set of dimension `< n + 1` has measure zero in `ℝⁿ⁺¹`), and Mathlib states the
easy case of Sard with it. -/
theorem exists_not_mem_normalize {k n : ℕ} (hkn : k < n) {P : Rn (k + 1) → Rn (n + 1)}
    (hP : Differentiable ℝ P) (h0 : ∀ u : Sphere k, P u ≠ 0) :
    ∃ q : Sphere n, ∀ u : Sphere k, ‖P u‖⁻¹ • P u ≠ (q : Rn (n + 1)) := by
  -- Suppose every `q ∈ Sⁿ` is `g(u)` for some `u ∈ Sᵏ`.
  by_contra hcon
  push Not at hcon
  -- The cone map `Φ(x) = |x| g(x/|x|)`.
  let Φ : Rn (k + 1) → Rn (n + 1) := fun x => ‖x‖ • (‖P (‖x‖⁻¹ • x)‖⁻¹ • P (‖x‖⁻¹ • x))
  have hsph : ∀ {m : ℕ} (x : Rn (m + 1)), x ≠ 0 → ‖x‖⁻¹ • x ∈ Sphere m := fun x hx => by
    rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr hx)]
  -- Step 1. `Φ` is differentiable at every `x ≠ 0` (Analysis I): `|x|` is (`x ≠ 0`), so are
  -- `x/|x|`, `P(x/|x|)`, and `|P(x/|x|)|` and its inverse, as `P(x/|x|) ≠ 0` (`x/|x| ∈ Sᵏ`).
  have hdiff : DifferentiableOn ℝ Φ {0}ᶜ := by
    intro x hx
    have hx : x ≠ 0 := hx
    have hP0 : P (‖x‖⁻¹ • x) ≠ 0 := h0 ⟨_, hsph x hx⟩
    apply DifferentiableAt.differentiableWithinAt
    have h1 : DifferentiableAt ℝ (fun x : Rn (k + 1) => ‖x‖) x :=
      differentiableAt_id.norm (𝕜 := ℝ) hx
    have h2 : DifferentiableAt ℝ (fun x : Rn (k + 1) => ‖x‖⁻¹ • x) x :=
      (h1.inv (norm_ne_zero_iff.mpr hx)).smul differentiableAt_id
    have h3 : DifferentiableAt ℝ (fun x => P (‖x‖⁻¹ • x)) x := hP.differentiableAt.comp x h2
    have h4 : DifferentiableAt ℝ (fun x => ‖P (‖x‖⁻¹ • x)‖) x := h3.norm (𝕜 := ℝ) hP0
    exact h1.smul ((h4.inv (norm_ne_zero_iff.mpr hP0)).smul h3)
  -- Step 2. `dim(ℝᵏ⁺¹ ∖ {0}) ≤ dim ℝᵏ⁺¹ = k + 1 < n + 1`, so the complement of
  -- `Φ(ℝᵏ⁺¹ ∖ {0})` is dense in `ℝⁿ⁺¹` (the easy case of Sard).
  have hdense := hdiff.dense_compl_image_of_dimH_lt_finrank (by
    calc dimH ({0}ᶜ : Set (Rn (k + 1))) ≤ dimH (univ : Set (Rn (k + 1))) :=
          dimH_mono (subset_univ _)
      _ = Module.finrank ℝ (Rn (k + 1)) := Real.dimH_univ_eq_finrank _
      _ < Module.finrank ℝ (Rn (n + 1)) := by simp; omega)
  -- Step 3. But every `w ≠ 0` is in the image: take `u ∈ Sᵏ` with `g(u) = w/|w|`; then
  -- `x = |w| u` has `|x| = |w|`, `x/|x| = u`, and `Φ(x) = |w| (w/|w|) = w`.
  have hsub : (Φ '' {0}ᶜ)ᶜ ⊆ {0} := by
    intro w hw
    by_contra hw0
    apply hw
    obtain ⟨u, hu⟩ := hcon ⟨‖w‖⁻¹ • w, hsph w hw0⟩
    have hw' : ‖w‖ ≠ 0 := norm_ne_zero_iff.mpr hw0
    have hu1 : ‖(u : Rn (k + 1))‖ = 1 := norm_eq_of_mem_sphere u
    have hnorm : ‖‖w‖ • (u : Rn (k + 1))‖ = ‖w‖ := by rw [norm_smul, hu1, norm_norm, mul_one]
    refine ⟨‖w‖ • (u : Rn (k + 1)), ?_, ?_⟩
    · show ‖w‖ • (u : Rn (k + 1)) ≠ 0
      rw [← norm_ne_zero_iff, hnorm]; exact hw'
    · have hu2 : ‖w‖⁻¹ • ‖w‖ • (u : Rn (k + 1)) = u := by
        rw [smul_smul, inv_mul_cancel₀ hw', one_smul]
      show ‖‖w‖ • (u : Rn (k + 1))‖ • _ = w
      rw [hnorm, hu2, hu]
      show ‖w‖ • (‖w‖⁻¹ • w) = w
      rw [smul_smul, mul_inv_cancel₀ hw', one_smul]
  -- Step 4. So `{0}` would be dense in `ℝⁿ⁺¹`; but `{0}` is closed and `e₀ = (1, 0, …, 0) ∉ {0}`.
  have h0d : Dense ({0} : Set (Rn (n + 1))) := hdense.mono hsub
  have := h0d (EuclideanSpace.single 0 1)
  rw [closure_singleton] at this
  simp at this

/-- **`thm:sk-sn`**, unpointed: for `k < n`, every continuous `f : Sᵏ → Sⁿ` is null-homotopic,
`f ≃ c` for a constant map `c`; that is, `[Sᵏ, Sⁿ] = *`. By the smooth route of
`rem:which-route`, not the book's simplicial approximation, and without base points.
Mathlib: none (`ContinuousMap.Nullhomotopic` is the notion; the statement is not in v4.34.1).

The proof: approximate `f` within `1` by a differentiable `P` (`exists_differentiable_near`);
`P ≠ 0` on `Sᵏ` as `|f| = 1`, and `g = P/|P|` is never antipodal to `f`, so `f ≃ g`
(`exr-6-antipodal`); `g` misses a point (`exists_not_mem_normalize`), so `g ≃ c`
(`prop:nonsurjective-nullhomotopic`); and `f ≃ g ≃ c` (`prop:hot-is-a-category`). -/
theorem sk_sn_nullhomotopic {k n : ℕ} (hkn : k < n) {f : Sphere k → Sphere n}
    (hf : Continuous f) : ∃ c : Sphere n, Homotopic f (fun _ => c) := by
  -- Step 1. `f` is continuous in Mathlib's sense (the bridge), so it has a differentiable
  -- approximation `P` with `|P(x) - f(x)| < 1` on `Sᵏ`.
  have hfM : _root_.Continuous f :=
    mathlib_continuous_of_eq (sphere_toMathlib k) (sphere_toMathlib n) hf
  obtain ⟨P, hP, hnear⟩ := exists_differentiable_near f hfM
  -- `P(u) ≠ 0`: else `|P(u) - f(u)| = |f(u)| = 1`, not `< 1`.
  have hP0 : ∀ u : Sphere k, P u ≠ 0 := fun u h => by
    have := hnear u
    rw [h, zero_sub, norm_neg, norm_eq_of_mem_sphere (f u)] at this
    exact lt_irrefl _ this
  -- Step 2. `g = P/|P| : Sᵏ → Sⁿ`, continuous by Analysis I through the bridges.
  have hmem : ∀ u : Sphere k, ‖P u‖⁻¹ • P u ∈ Sphere n := fun u => by
    rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr (hP0 u))]
  let g : Sphere k → Sphere n := fun u => ⟨‖P u‖⁻¹ • P u, hmem u⟩
  have hg : Continuous g := continuous_of_mathlib_eq (sphere_toMathlib k) (sphere_toMathlib n)
    (Continuous.subtype_mk (((hP.continuous.comp _root_.continuous_subtype_val).norm.inv₀
      fun u => norm_ne_zero_iff.mpr (hP0 u)).smul
      (hP.continuous.comp _root_.continuous_subtype_val)) _)
  -- Step 3. `f(x) ≠ -g(x)`: else `P(x) = -|P(x)| f(x)`, and
  -- `|P(x) - f(x)| = |(|P(x)| + 1) f(x)| = |P(x)| + 1 ≥ 1`.
  have hfg : ∀ x, (f x : Rn (n + 1)) ≠ -(g x : Rn (n + 1)) := by
    intro x h
    have hr : ‖P x‖ ≠ 0 := norm_ne_zero_iff.mpr (hP0 x)
    have hp : P x = -(‖P x‖ • (f x : Rn (n + 1))) := by
      rw [h]
      show P x = -(‖P x‖ • -(‖P x‖⁻¹ • P x))
      rw [smul_neg, neg_neg, smul_smul, mul_inv_cancel₀ hr, one_smul]
    have h1 := hnear x
    have h2 : P x - f x = -((‖P x‖ + 1) • (f x : Rn (n + 1))) := by
      conv_lhs => rw [hp]
      rw [add_smul, one_smul, neg_add]; abel
    rw [h2, norm_neg, norm_smul, norm_eq_of_mem_sphere (f x), mul_one,
      Real.norm_of_nonneg (by positivity)] at h1
    linarith [norm_nonneg (P x)]
  -- Step 4. `g` misses some `q ∈ Sⁿ` (step 3 of `rem:which-route`), so `g ≃ c`
  -- (`prop:nonsurjective-nullhomotopic`); and `f ≃ g` (`exr-6-antipodal`), so `f ≃ c`.
  obtain ⟨q, hq⟩ := exists_not_mem_normalize hkn hP hP0
  obtain ⟨c, hc⟩ := nullhomotopic_of_not_surjective hg (q := q)
    (fun x h => hq x (congrArg Subtype.val h))
  exact ⟨c, (homotopic_of_ne_neg hf hg hfg).trans hc⟩

end

